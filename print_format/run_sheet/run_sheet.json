{
 "align_labels_right": 0,
 "creation": "2025-01-26 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Run Sheet",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 9,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 9pt;\n            line-height: 1.4;\n            color: #000;\n            background: white;\n        }\n        \n        .runsheet-container {\n            width: 100%;\n            max-width: 210mm;\n            margin: 0 auto;\n            padding: 0;\n            background: white;\n            display: flex;\n            flex-direction: column;\n            min-height: 100vh;\n            position: relative;\n        }\n        \n        .top-section {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            min-height: 0;\n        }\n        \n        .bottom-section {\n            margin-top: auto;\n            flex: 0 0 auto;\n        }\n        \n        /* Header Section */\n        .header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 3mm;\n        }\n        \n        .logo-placeholder {\n            width: 60mm;\n            height: 30mm;\n            background: #e0e0e0;\n            border: 1px solid #ccc;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 7pt;\n            color: #666;\n        }\n        \n        .company-logo {\n            width: 60mm;\n            height: 30mm;\n            object-fit: contain;\n        }\n        \n        .company-info {\n            flex: 1;\n            text-align: left;\n            padding-left: 3mm;\n        }\n        \n        .company-name {\n            font-size: 16pt;\n            font-weight: 900;\n            margin-bottom: 0;\n            text-transform: uppercase;\n        }\n        \n        .company-address {\n            font-size: 7pt;\n            line-height: 1.3;\n            margin-bottom: 0;\n        }\n        \n        .vat-reg {\n            font-size: 8.5pt;\n        }\n        \n        /* Document Title */\n        .document-title {\n            text-align: center;\n            font-size: 18pt;\n            font-weight: 900;\n            margin: 3mm 0;\n        }\n        \n        /* Separator Line */\n        .separator {\n            border-bottom: 1px solid #000;\n            margin: 3mm 0;\n        }\n        \n        /* Main Body */\n        .main-body {\n            display: flex;\n            flex-direction: column;\n            justify-content: flex-start;\n            margin-bottom: 0;\n            margin-top: 35mm;\n            position: relative;\n        }\n        \n        .info-block {\n            border: 2px solid #000;\n            padding: 1mm 1.5mm;\n            font-size: 7.5pt;\n            page-break-inside: avoid;\n            margin-bottom: 2mm;\n        }\n        \n        .info-block .info-title {\n            font-weight: 900;\n            font-size: 8pt;\n            margin-bottom: 1mm;\n            border-bottom: 1px solid #000;\n            padding-bottom: 0.5mm;\n            letter-spacing: 0.02em;\n        }\n        \n        .info-block .info-content {\n            display: flex;\n            justify-content: space-between;\n            gap: 3mm;\n        }\n        \n        .left-column {\n            flex: 1;\n            padding-right: 2mm;\n        }\n        \n        .right-column {\n            flex: 1;\n            padding-left: 2mm;\n        }\n        \n        .field-row {\n            display: flex;\n            margin-bottom: 0.2mm;\n            align-items: center;\n            gap: 1.5mm;\n            min-height: 3.5mm;\n        }\n        \n        .field-label {\n            font-weight: bold;\n            font-size: 7.5pt;\n            min-width: 22mm;\n            flex-shrink: 0;\n            text-align: right;\n        }\n        \n        .field-value {\n            flex: 1;\n            font-size: 7.5pt;\n            min-width: 0;\n        }\n        \n        /* QR Code Section */\n        .qr-section {\n            position: absolute;\n            top: -35mm;\n            right: 1.5mm;\n            text-align: right;\n            z-index: 10;\n            margin-bottom: 3mm;\n        }\n        \n        .qr-code {\n            width: 1in;\n            height: 1in;\n            border: none;\n        }\n        \n        .runsheet-title-qr {\n            font-size: 14pt;\n            font-weight: 900;\n            margin-top: 0.11mm;\n            margin-bottom: -1mm;\n            text-align: right;\n            text-transform: uppercase;\n        }\n        \n        .reference-number {\n            font-size: 8pt;\n            font-weight: regular;\n            margin-top: 0.1mm;\n        }\n        \n        /* Legs Table */\n        .legs-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-top: 2mm;\n            margin-bottom: 0;\n            page-break-inside: auto;\n        }\n        \n        .table-header {\n            background: #e0e0e0;\n            border: 2px solid #000;\n        }\n        \n        .table-header th {\n            padding: 0.3mm 0.5mm;\n            text-align: left;\n            font-size: 7pt;\n            font-weight: bold;\n            color: #000;\n            border-top: 2px solid #000;\n            border-bottom: 2px solid #000;\n            border-left: none;\n            border-right: none;\n        }\n        \n        .table-header th:first-child {\n            border-left: 2px solid #000;\n        }\n        \n        .table-header th:last-child {\n            border-right: 2px solid #000;\n        }\n        \n        .table-row {\n            border-bottom: 1px solid #ddd;\n        }\n        \n        .table-row td {\n            padding: 0.3mm 0.5mm;\n            font-size: 7pt;\n            background: white;\n            border: none;\n        }\n        \n        .table-row:last-child td {\n            border-bottom: none;\n        }\n        \n        /* Footer Section */\n        .footer-section {\n            margin-top: 10mm;\n            padding-top: 2mm;\n            padding-bottom: 1mm;\n            border-top: 2px solid #000;\n            font-size: 7pt;\n            background: white;\n            display: block;\n            visibility: visible;\n            page-break-inside: avoid;\n        }\n        \n        @page {\n            size: A4;\n            margin: 12mm 12mm 20mm 12mm;\n        }\n        \n        @media print {\n            body {\n                margin: 0;\n                padding: 0;\n            }\n            .runsheet-container {\n                padding: 0;\n                padding-bottom: 30mm;\n                max-width: 100%;\n            }\n            .page-break {\n                page-break-after: always;\n            }\n            .footer-section {\n                position: fixed;\n                bottom: 0;\n                left: 0;\n                right: 0;\n                width: 100%;\n                background: white;\n                padding-top: 2mm;\n                padding-bottom: 2mm;\n                padding-left: 12mm;\n                padding-right: 12mm;\n                border-top: 2px solid #000;\n                margin: 0;\n                box-sizing: border-box;\n                z-index: 1000;\n                display: block !important;\n            }\n        }\n        \n        @media screen {\n            html, body {\n                overflow-x: hidden;\n                overflow-y: auto;\n                min-height: 100vh;\n            }\n            .runsheet-container {\n                min-height: 100vh;\n            }\n        }\n    </style>\n</head>\n<body>\n\n{% set default_company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") or frappe.db.get_default(\"company\") %}\n{% set company_doc = None %}\n{% if doc.company and frappe.db.exists(\"Company\", doc.company) %}\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n{% elif default_company and frappe.db.exists(\"Company\", default_company) %}\n{% set company_doc = frappe.get_doc(\"Company\", default_company) %}\n{% endif %}\n<div class=\"runsheet-container\">\n        <!-- Header -->\n        <div class=\"header\">\n            {% if company_doc %}\n            {% if company_doc.company_logo %}\n                <img src=\"{{ company_doc.company_logo }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% elif company_doc.logo %}\n                <img src=\"{{ company_doc.logo }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% elif company_doc.image %}\n                <img src=\"{{ company_doc.image }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% else %}\n                <div class=\"logo-placeholder\">\n                    company_logo\n                </div>\n            {% endif %}\n<div class=\"company-info\">\n                <div class=\"company-name\">{{ company_doc.company_name or doc.company }}</div>\n                <div class=\"company-address\">\n                    {% if company_doc.address %}\n                        {% set company_address = frappe.get_doc(\"Address\", company_doc.address) %}\n                        {{ company_address.address_line1 if company_address.address_line1 else '' }}\n                        {% if company_address.address_line2 %}{{ company_address.address_line2 }}{% endif %}\n{% if company_address.city %}{{ company_address.city }}{% endif %}\n{% if company_address.state %}, {{ company_address.state }}{% endif %}\n{% if company_address.country %}{{ company_address.country }}{% endif %}\n{% if company_address.pincode %} {{ company_address.pincode }}{% endif %}\n                    {% elif company_doc.address_line1 %}\n                        {{ company_doc.address_line1 }}<br>\n                        {% if company_doc.address_line2 %}{{ company_doc.address_line2 }}<br>{% endif %}\n                        {{ company_doc.city }}{% if company_doc.state %}, {{ company_doc.state }}{% endif %}<br>\n                        {{ company_doc.country }}{% if company_doc.pincode %} {{ company_doc.pincode }}{% endif %}\n                    {% endif %}\n                </div>\n                <div class=\"vat-reg\">\n                    {% if company_doc.tax_id %}\n                        VAT Reg. TIN: {{ company_doc.tax_id }}\n                    {% elif company_doc.tin %}\n                        VAT Reg. TIN: {{ company_doc.tin }}\n                    {% endif %}\n                </div>\n            </div>\n            {% else %}\n                <div class=\"logo-placeholder\">company_logo</div>\n                <div class=\"company-info\">\n                    <div class=\"company-name\">{{ doc.company or default_company or '' }}</div>\n                </div>\n            {% endif %}\n        </div>\n        \n        <div class=\"document-title\">RUN SHEET</div>\n        <div class=\"separator\"></div>\n        \n        <!-- Top Section: Main Body -->\n        <div class=\"top-section\">\n            <div class=\"main-body\">\n                <!-- QR Code Section - Positioned in top right of main body -->\n                <div class=\"qr-section\">\n                    {% set qr_url = 'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + doc.name|urlencode %}\n                    <img src=\"{{ qr_url }}\" alt=\"QR Code\" class=\"qr-code\" />\n                    <div class=\"runsheet-title-qr\">RUN SHEET</div>\n                    <div class=\"reference-number\">{{ doc.name }}</div>\n                </div>\n                \n                <!-- Run Sheet Information -->\n                <div class=\"info-block\">\n                    <div class=\"info-title\">RUN SHEET INFORMATION</div>\n                    <div class=\"info-content\">\n                        <div class=\"left-column\">\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">RUN SHEET NO:</div>\n                                <div class=\"field-value\">{{ doc.name }}</div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">RUN DATE:</div>\n                                <div class=\"field-value\">\n                                    {% if doc.run_date %}\n                                        {{ frappe.utils.format_datetime(doc.run_date, 'MM-dd-yyyy HH:mm') }}\n                                    {% endif %}\n                                </div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">RUN TYPE:</div>\n                                <div class=\"field-value\">{{ doc.run_type or '-' }}</div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">ROUTE NAME:</div>\n                                <div class=\"field-value\">{{ doc.route_name or '-' }}</div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">STATUS:</div>\n                                <div class=\"field-value\">{{ doc.status or '-' }}</div>\n                            </div>\n                        </div>\n                        \n                        <div class=\"right-column\">\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">VEHICLE:</div>\n                                <div class=\"field-value\">\n                                    {% if doc.vehicle %}\n                                        {{ doc.vehicle }}\n                                    {% else %}\n                                        -\n                                    {% endif %}\n                                </div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">VEHICLE TYPE:</div>\n                                <div class=\"field-value\">{{ doc.vehicle_type or '-' }}</div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">TRANSPORT COMPANY:</div>\n                                <div class=\"field-value\">\n                                    {% if doc.transport_company %}\n                                        {{ doc.transport_company }}\n                                    {% else %}\n                                        -\n                                    {% endif %}\n                                </div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">DRIVER:</div>\n                                <div class=\"field-value\">\n                                    {% if doc.driver_name %}\n                                        {{ doc.driver_name }}\n                                    {% elif doc.driver %}\n                                        {{ doc.driver }}\n                                    {% else %}\n                                        -\n                                    {% endif %}\n                                </div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">TRAILER TYPE:</div>\n                                <div class=\"field-value\">{{ doc.trailer_type or '-' }}</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- Dispatch and Return Information -->\n                <div class=\"info-block\">\n                    <div class=\"info-title\">DISPATCH AND RETURN INFORMATION</div>\n                    <div class=\"info-content\">\n                        <div class=\"left-column\">\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">DISPATCH TERMINAL:</div>\n                                <div class=\"field-value\">{{ doc.dispatch_terminal or '-' }}</div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">DISPATCHER:</div>\n                                <div class=\"field-value\">\n                                    {% if doc.dispatcher %}\n                                        {{ doc.dispatcher }}\n                                    {% else %}\n                                        -\n                                    {% endif %}\n                                </div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">EST. DISPATCH:</div>\n                                <div class=\"field-value\">\n                                    {% if doc.estimated_dispatch_datetime %}\n                                        {{ frappe.utils.format_datetime(doc.estimated_dispatch_datetime, 'MM-dd-yyyy HH:mm') }}\n                                    {% else %}\n                                        -\n                                    {% endif %}\n                                </div>\n                            </div>\n                        </div>\n                        \n                        <div class=\"right-column\">\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">RETURN TERMINAL:</div>\n                                <div class=\"field-value\">{{ doc.return_terminal or '-' }}</div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">RETURN INSPECTOR:</div>\n                                <div class=\"field-value\">\n                                    {% if doc.return_inspector %}\n                                        {{ doc.return_inspector }}\n                                    {% else %}\n                                        -\n                                    {% endif %}\n                                </div>\n                            </div>\n                            <div class=\"field-row\">\n                                <div class=\"field-label\">EST. RETURN:</div>\n                                <div class=\"field-value\">\n                                    {% if doc.estimated_return_datetime %}\n                                        {{ frappe.utils.format_datetime(doc.estimated_return_datetime, 'MM-dd-yyyy HH:mm') }}\n                                    {% else %}\n                                        -\n                                    {% endif %}\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                \n                <!-- Transport Legs Table -->\n                {% if doc.legs and doc.legs|length > 0 %}\n                <table class=\"legs-table\">\n                    <thead class=\"table-header\">\n                        <tr>\n                            <th>LEG</th>\n                            <th>TRANSPORT JOB</th>\n                            <th>CUSTOMER</th>\n                            <th>FROM</th>\n                            <th>TO</th>\n                            <th>PICK MODE</th>\n                            <th>DROP MODE</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        {% for leg in doc.legs %}\n                        <tr class=\"table-row\">\n                            <td>\n                                {% if leg.transport_leg %}\n                                    {{ leg.transport_leg }}\n                                {% else %}\n                                    -\n                                {% endif %}\n                            </td>\n                            <td>\n                                {% if leg.transport_job %}\n                                    {{ leg.transport_job }}\n                                {% else %}\n                                    -\n                                {% endif %}\n                            </td>\n                            <td>\n                                {% if leg.customer %}\n                                    {{ leg.customer }}\n                                {% else %}\n                                    -\n                                {% endif %}\n                            </td>\n                            <td>\n                                {% if leg.facility_from %}\n                                    {{ leg.facility_from }}\n                                {% elif leg.address_from %}\n                                    {% set from_address = frappe.get_doc(\"Address\", leg.address_from) %}\n                                    {{ from_address.address_line1 or '' }}\n                                {% else %}\n                                    -\n                                {% endif %}\n                            </td>\n                            <td>\n                                {% if leg.facility_to %}\n                                    {{ leg.facility_to }}\n                                {% elif leg.address_to %}\n                                    {% set to_address = frappe.get_doc(\"Address\", leg.address_to) %}\n                                    {{ to_address.address_line1 or '' }}\n                                {% else %}\n                                    -\n                                {% endif %}\n                            </td>\n                            <td>{{ leg.pick_mode or '-' }}</td>\n                            <td>{{ leg.drop_mode or '-' }}</td>\n                        </tr>\n                        {% endfor %}\n                    </tbody>\n                </table>\n                {% else %}\n                <div style=\"text-align: center; padding: 5mm; font-size: 8pt; border: 1px solid #ddd; margin-top: 2mm;\">\n                    No transport legs assigned\n                </div>\n                {% endif %}\n            </div>\n        </div>\n        \n        <!-- Bottom Section: Footer -->\n        <div class=\"bottom-section\">\n            <div class=\"footer-section\">\n                <div style=\"text-align: center; margin-bottom: 1mm;\">\n                    <strong>{{ company_doc.company_name or doc.company }}</strong>\n                </div>\n                <div style=\"text-align: center; font-size: 6pt;\">\n                    This is a computer-generated document. No signature required.\n                </div>\n            </div>\n        </div>\n    </div>\n</body>\n</html>\n",
