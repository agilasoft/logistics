 "creation": "2026-04-21 14:03:53.503813",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Transport Order",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body { font-family: Arial, Helvetica, sans-serif; font-size: 9pt; line-height: 1.4; color: #000; background: white; }\n        .order-container { width: 100%; max-width: 210mm; margin: 0 auto; padding: 0; background: white; display: flex; flex-direction: column; min-height: 100vh; position: relative; }\n        .top-section { flex: 0 0 auto; }\n        .bottom-section { margin-top: auto; flex: 0 0 auto; }\n        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3mm; }\n        .logo-placeholder { width: 60mm; height: 30mm; background: #e0e0e0; border: 1px solid #ccc; display: flex; align-items: center; justify-content: center; font-size: 7pt; color: #666; }\n        .company-logo { width: 60mm; height: 30mm; object-fit: contain; }\n        .company-info { flex: 1; text-align: left; padding-left: 3mm; }\n        .company-name { font-size: 12pt; font-weight: bold; margin-bottom: 0; }\n        .company-address { font-size: 7pt; line-height: 1.3; margin-bottom: 0; }\n        .vat-reg { font-size: 7pt; }\n        .main-body { display: flex; justify-content: space-between; margin-bottom: 0; margin-top: 35mm; border: 2px solid #000; padding: 1.5mm; position: relative; }\n        .left-column { flex: 1; padding-right: 5mm; }\n        .right-column { flex: 1; padding-left: 5mm; }\n        .field-row { display: flex; margin-bottom: -1mm; align-items: flex-start; gap: 0.3mm; }\n        .field-label { font-weight: 900; min-width: 28mm; font-size: 8pt; flex-shrink: 0; text-align: right; }\n        .left-column .field-label { text-align: right; min-width: 22mm; }\n        .left-column .field-row { gap: 0.1mm; }\n        .field-value { flex: 1; font-size: 8pt; min-height: 5mm; padding: 0.3mm 0.5mm; background: white; }\n        .customer-info-section { position: absolute; top: -35mm; left: 1.5mm; z-index: 10; max-width: 80mm; }\n        .customer-label { font-weight: bold; font-size: 8pt; margin-top: 5mm; margin-bottom: 1mm; line-height: 1; }\n        .customer-name-box { padding: 0.3mm 0.5mm; font-size: 12pt; font-weight: 900; margin-bottom: 0.1mm; margin-top: -1mm; line-height: 1; background: white; }\n        .customer-address-box { padding: 0.3mm 0.5mm; font-size: 8pt; background: white; width: 100mm; }\n        .qr-section { position: absolute; top: -35mm; right: 1.5mm; text-align: right; z-index: 10; margin-bottom: 30mm; }\n        .qr-code { width: 20mm; height: 20mm; border: 0 solid #000; }\n        .order-title-qr { font-size: 16pt; font-weight: 900; margin-top: 0.11mm; margin-bottom: -1mm; text-align: right; }\n        .reference-number { font-size: 8pt; font-weight: normal; margin-top: 0.1mm; }\n        /* Table Section \u2014 same design as Inbound Order items table */\n        .items-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-top: 2mm;\n            margin-bottom: 0;\n            border: 1px solid #bbb;\n        }\n        .items-table thead { display: table-header-group; }\n        .items-table tbody { display: table-row-group; }\n        .items-table tr {\n            page-break-inside: avoid;\n            break-inside: avoid;\n        }\n        .table-header { background: #e0e0e0; }\n        .table-header th {\n            padding: 1.2mm 1mm;\n            text-align: center;\n            font-size: 7pt;\n            font-weight: bold;\n            color: #000;\n            text-transform: uppercase;\n            border: 1px solid #bbb;\n            vertical-align: middle;\n        }\n        .table-header th.col-commodity { text-align: center; }\n        .table-row td {\n            padding: 1.2mm 1mm;\n            font-size: 7pt;\n            background: white;\n            border-left: 1px solid #bbb;\n            border-right: 1px solid #bbb;\n            border-top: none;\n            border-bottom: 1px dashed #999;\n            vertical-align: middle;\n        }\n        .table-row:last-child td { border-bottom: 1px solid #bbb; }\n        .items-table tbody tr.table-row.page-chunk-end td { border-bottom: 1px solid #bbb; }\n        .items-table tbody tr.table-row.page-break-before {\n            page-break-before: always;\n            break-before: page;\n        }\n        .items-table .col-num,\n        .items-table .col-hs,\n        .items-table .col-qty,\n        .items-table .col-packs,\n        .items-table .col-weight,\n        .items-table .col-volume,\n        .items-table .col-mode { text-align: center; }\n        .items-table .col-commodity,\n        .items-table .col-text { text-align: left; }\n        .items-table tbody tr:last-child td { border-bottom: 1px solid #bbb; }\n        .table-header th.col-text { text-align: left; }\n        .section-title {\n            font-size: 8pt;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin: 3mm 0 1mm 0;\n        }\n        .footer-section { margin-top: 10mm; padding-top: 2mm; padding-bottom: 1mm; border-top: 2px solid #000; font-size: 7pt; background: white; display: block; visibility: visible; page-break-inside: avoid; }\n        @page { size: A4; margin: 12mm 12mm 20mm 12mm; }\n        @media print {\n            body { margin: 0; padding: 0; }\n            .order-container { padding: 0; padding-bottom: 30mm; max-width: 100%; }\n            .items-table {\n                page-break-inside: auto;\n                break-inside: auto;\n            }\n            .items-table thead { display: table-header-group; }\n            .items-table tbody { display: table-row-group; }\n            .items-table tbody tr {\n                page-break-inside: avoid;\n                break-inside: avoid;\n            }\n            .items-table tbody tr.table-row.page-break-before {\n                page-break-before: always;\n                break-before: page;\n            }\n            .footer-section { position: fixed; bottom: 0; left: 0; right: 0; width: 100%; background: white; padding-top: 2mm; padding-bottom: 2mm; padding-left: 12mm; padding-right: 12mm; border-top: 2px solid #000; margin: 0; box-sizing: border-box; z-index: 1000; }\n        }\n    </style>\n</head>\n<body>\n\n{% set default_company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") or frappe.db.get_default(\"company\") %}\n{% set company_doc = None %}\n{% if doc.company and frappe.db.exists(\"Company\", doc.company) %}\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n{% elif default_company and frappe.db.exists(\"Company\", default_company) %}\n{% set company_doc = frappe.get_doc(\"Company\", default_company) %}\n{% endif %}\n<div class=\"order-container\">\n        <div class=\"header\">\n            {% if company_doc %}\n            {% if company_doc.company_logo %}\n                <img src=\"{{ company_doc.company_logo }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% elif company_doc.logo %}\n                <img src=\"{{ company_doc.logo }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% elif company_doc.image %}\n                <img src=\"{{ company_doc.image }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% else %}\n                <div class=\"logo-placeholder\">company_logo</div>\n            {% endif %}\n<div class=\"company-info\">\n                <div class=\"company-name\">{{ company_doc.company_name or doc.company }}</div>\n                <div class=\"company-address\">\n                    {% if company_doc.address %}\n                        {% set company_address = frappe.get_doc(\"Address\", company_doc.address) %}\n                        {{ company_address.address_line1 or '' }}\n                        {% if company_address.address_line2 %} {{ company_address.address_line2 }}{% endif %}\n{% if company_address.city %} {{ company_address.city }}{% endif %}\n{% if company_address.state %}, {{ company_address.state }}{% endif %}\n{% if company_address.country %} {{ company_address.country }}{% endif %}\n{% if company_address.pincode %} {{ company_address.pincode }}{% endif %}\n                    {% elif company_doc.address_line1 %}\n                        {{ company_doc.address_line1 }}<br>\n                        {% if company_doc.address_line2 %}{{ company_doc.address_line2 }}<br>{% endif %}\n                        {{ company_doc.city }}{% if company_doc.state %}, {{ company_doc.state }}{% endif %}<br>\n                        {{ company_doc.country }}{% if company_doc.pincode %} {{ company_doc.pincode }}{% endif %}\n                    {% endif %}\n                </div>\n                <div class=\"vat-reg\">\n                    {% if doc.branch %}\n                        {% set branch_doc = frappe.get_doc(\"Branch\", doc.branch) %}\n                        {% if branch_doc.custom_registration_details %}\n                            {{ branch_doc.custom_registration_details }}\n                        {% elif company_doc.tax_id %}\n                            VAT Reg. TIN: {{ company_doc.tax_id }}\n                        {% elif company_doc.tin %}\n                            VAT Reg. TIN: {{ company_doc.tin }}\n                        {% endif %}\n                    {% elif company_doc.tax_id %}\n                        VAT Reg. TIN: {{ company_doc.tax_id }}\n                    {% elif company_doc.tin %}\n                        VAT Reg. TIN: {{ company_doc.tin }}\n                    {% endif %}\n                </div>\n            </div>\n            {% else %}\n                <div class=\"logo-placeholder\">company_logo</div>\n                <div class=\"company-info\">\n                    <div class=\"company-name\">{{ doc.company or default_company or '' }}</div>\n                </div>\n            {% endif %}\n        </div>\n        <div class=\"top-section\">\n        <div class=\"main-body\">\n            <div class=\"customer-info-section\">\n                <div class=\"customer-label\">CUSTOMER</div>\n                <div class=\"customer-name-box\">\n                    {% if doc.customer %}\n                        {% set cust = frappe.get_doc(\"Customer\", doc.customer) %}\n                        {{ cust.customer_name or doc.customer }}\n                    {% endif %}\n                </div>\n                <div class=\"customer-address-box\">\n                    {% if doc.customer %}\n                        {% set cust = frappe.get_doc(\"Customer\", doc.customer) %}\n                        {% if cust.customer_primary_address %}\n                            {% set addr = frappe.get_doc(\"Address\", cust.customer_primary_address) %}\n                            {{ addr.address_line1 or '' }}\n                            {% if addr.address_line2 %} {{ addr.address_line2 }}{% endif %}\n{% if addr.city %} {{ addr.city }}{% endif %}\n{% if addr.state %}, {{ addr.state }}{% endif %}\n{% if addr.country %} {{ addr.country }}{% endif %}\n{% if addr.pincode %} {{ addr.pincode }}{% endif %}\n                        {% endif %}\n                    {% endif %}\n                </div>\n            </div>\n            <div class=\"qr-section\">\n                {% set qr_url = 'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + doc.name|urlencode %}\n                <img src=\"{{ qr_url }}\" alt=\"QR Code\" class=\"qr-code\" />\n                <div class=\"order-title-qr\">TRANSPORT ORDER</div>\n                <div class=\"reference-number\">{{ doc.name }}</div>\n            </div>\n            <div class=\"left-column\">\n                <div class=\"field-row\"><div class=\"field-label\">SHIPPER:</div><div class=\"field-value\">{% if doc.shipper %}{% set sh = frappe.get_doc(\"Shipper\", doc.shipper) %}{{ sh.shipper_name or doc.shipper }}{% endif %}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">CONSIGNEE:</div><div class=\"field-value\">{% if doc.consignee %}{% set cn = frappe.get_doc(\"Consignee\", doc.consignee) %}{{ cn.consignee_name or doc.consignee }}{% endif %}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">TRANSPORT CO.:</div><div class=\"field-value\">{{ doc.transport_company or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">JOB TYPE:</div><div class=\"field-value\">{{ doc.transport_job_type or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">FROM / TO:</div><div class=\"field-value\">{{ doc.location_from or '' }} \u2192 {{ doc.location_to or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">LOC. TYPE:</div><div class=\"field-value\">{{ doc.location_type or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">CONTAINER:</div><div class=\"field-value\">{{ doc.container_no or doc.container or '' }}</div></div>\n            </div>\n            <div class=\"right-column\">\n                <div class=\"field-row\"><div class=\"field-label\">BOOKING DATE:</div><div class=\"field-value\">{% if doc.booking_date %}{{ frappe.utils.formatdate(doc.booking_date, 'MM-dd-yyyy') }}{% endif %}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">SCHEDULED:</div><div class=\"field-value\">{% if doc.scheduled_date %}{{ frappe.utils.formatdate(doc.scheduled_date, 'MM-dd-yyyy') }}{% endif %}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">CUST. REF:</div><div class=\"field-value\">{{ doc.customer_ref_no or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">MODE / LOAD:</div><div class=\"field-value\">{{ doc.transport_mode or '' }} / {{ doc.load_type or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">VEHICLE:</div><div class=\"field-value\">{{ doc.vehicle_type or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">REEFER / DG:</div><div class=\"field-value\">{% if doc.reefer %}Reefer {% endif %}{% if doc.contains_dangerous_goods %}DG{% endif %}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">SALES QUOTE:</div><div class=\"field-value\">{{ doc.sales_quote or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">JOB NUMBER:</div><div class=\"field-value\">{{ doc.job_number or '' }}</div></div>\n            </div>\n        </div>\n        <div class=\"section-title\">Leg Plan</div>\n        <table class=\"items-table\">\n            <thead class=\"table-header\">\n                <tr>\n                    <th style=\"width: 6mm;\">No.</th>\n                    <th class=\"col-text\">Facility Type From</th>\n                    <th class=\"col-text\">Facility From</th>\n                    <th class=\"col-text\">Facility Type To</th>\n                    <th class=\"col-text\">Facility To</th>\n                    <th>Pick Mode</th>\n                    <th>Drop Mode</th>\n                    <th class=\"col-text\">Pick Address</th>\n                    <th class=\"col-text\">Drop Address</th>\n                    <th>Pick Date and Time</th>\n                    <th>Drop Date and Time</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% if doc.legs %}\n                    {% for row in doc.legs %}\n                        <tr class=\"table-row\">\n                            <td class=\"col-num\">{{ loop.index }}</td>\n                            <td class=\"col-text\">{{ row.facility_type_from or '' }}</td>\n                            <td class=\"col-text\">{{ row.facility_from or '' }}</td>\n                            <td class=\"col-text\">{{ row.facility_type_to or '' }}</td>\n                            <td class=\"col-text\">{{ row.facility_to or '' }}</td>\n                            <td class=\"col-mode\">{{ row.pick_mode or '' }}</td>\n                            <td class=\"col-mode\">{{ row.drop_mode or '' }}</td>\n                            <td class=\"col-text\">{{ row.pick_address or '' }}</td>\n                            <td class=\"col-text\">{{ row.drop_address or '' }}</td>\n                            <td class=\"col-mode\">{% if row.pick_datetime %}{{ frappe.utils.format_datetime(row.pick_datetime, 'MM-dd-yyyy HH:mm') }}{% endif %}</td>\n                            <td class=\"col-mode\">{% if row.drop_datetime %}{{ frappe.utils.format_datetime(row.drop_datetime, 'MM-dd-yyyy HH:mm') }}{% endif %}</td>\n                        </tr>\n                    {% endfor %}\n                {% else %}\n                    <tr class=\"table-row\"><td colspan=\"11\" style=\"text-align:center;padding:5mm;\">No legs</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n\n        <div class=\"section-title\">Packages</div>\n        <table class=\"items-table\">\n            <thead class=\"table-header\">\n                <tr>\n                    <th style=\"width: 6mm;\">#</th>\n                    <th class=\"col-commodity\">Commodity</th>\n                    <th>HS</th>\n                    <th>Qty</th>\n                    <th>Packs</th>\n                    <th>Weight</th>\n                    <th>Volume</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% if doc.packages %}\n                    {% for row in doc.packages %}\n                        {% set first_page_rows = 8 %}\n                        {% set cont_page_rows = 19 %}\n                        {% set page_break = loop.index == (first_page_rows + 1) or (loop.index > (first_page_rows + 1) and (loop.index - first_page_rows - 1) % cont_page_rows == 0) %}\n                        {% set chunk_end = loop.index == first_page_rows or (loop.index > first_page_rows and (loop.index - first_page_rows) % cont_page_rows == 0) %}\n                        <tr class=\"table-row{% if page_break %} page-break-before{% endif %}{% if chunk_end %} page-chunk-end{% endif %}\">\n                            <td class=\"col-num\">{{ loop.index }}</td>\n                            <td class=\"col-commodity\">{{ row.commodity or '' }}</td>\n                            <td class=\"col-hs\">{{ row.hs_code or '' }}</td>\n                            <td class=\"col-qty\">{% if row.quantity is not none %}{{ frappe.utils.fmt_money(row.quantity, precision=2) }}{% endif %}</td>\n                            <td class=\"col-packs\">{% if row.no_of_packs is not none %}{{ frappe.utils.fmt_money(row.no_of_packs, precision=2) }}{% endif %}</td>\n                            <td class=\"col-weight\">{% if row.weight is not none %}{{ frappe.utils.fmt_money(row.weight, precision=2) }}{% endif %}</td>\n                            <td class=\"col-volume\">{% if row.volume is not none %}{{ frappe.utils.fmt_money(row.volume, precision=2) }}{% endif %}</td>\n                        </tr>\n                    {% endfor %}\n                {% else %}\n                    <tr class=\"table-row\"><td colspan=\"7\" style=\"text-align:center;padding:5mm;\">No packages</td></tr>\n                {% endif %}\n            </tbody>\n        </table>\n        </div>\n        <div class=\"bottom-section\">\n        <div class=\"footer-section\">\n            <div>Company: {{ doc.company or '' }}</div>\n            {% if doc.branch %}<div>Branch: {{ doc.branch }}</div>{% endif %}\n{% if doc.cost_center %}<div>Cost Center: {{ doc.cost_center }}</div>{% endif %}\n{% if doc.profit_center %}<div>Profit Center: {{ doc.profit_center }}</div>{% endif %}\n        </div>\n        </div>\n    </div>\n</body>\n</html>",
