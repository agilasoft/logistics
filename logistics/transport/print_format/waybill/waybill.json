{
 "align_labels_right": 0,
 "creation": "2025-10-01 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Transport Leg",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 9,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 9pt;\n            line-height: 1.3;\n            color: #000;\n            background: white;\n        }\n        \n        .waybill-document {\n            width: 100%;\n            max-width: 190mm;\n            margin: 0 auto;\n            padding: 0;\n            background: white;\n        }\n        \n        /* Header */\n        .waybill-header {\n            text-align: center;\n            padding: 3mm 0;\n            border-bottom: 3px solid #000;\n            margin-bottom: 3mm;\n        }\n        \n        .waybill-title {\n            font-size: 18pt;\n            font-weight: bold;\n            letter-spacing: 2px;\n            margin-bottom: 2mm;\n        }\n        \n        .waybill-subtitle {\n            font-size: 10pt;\n            color: #666;\n        }\n        \n        /* Waybill Number and Date */\n        .info-bar {\n            display: flex;\n            justify-content: space-between;\n            padding: 2mm;\n            background: #f0f0f0;\n            border: 1px solid #000;\n            margin-bottom: 3mm;\n        }\n        \n        .info-item {\n            flex: 1;\n        }\n        \n        .info-label {\n            font-size: 7pt;\n            font-weight: bold;\n            color: #666;\n            text-transform: uppercase;\n        }\n        \n        .info-value {\n            font-size: 11pt;\n            font-weight: bold;\n            margin-top: 1mm;\n        }\n        \n        /* Box System */\n        .box {\n            border: 2px solid #000;\n            position: relative;\n            margin-bottom: 2mm;\n        }\n        \n        .box-label {\n            position: absolute;\n            top: -8px;\n            left: 5mm;\n            background: white;\n            padding: 0 2mm;\n            font-size: 7pt;\n            font-weight: bold;\n            text-transform: uppercase;\n        }\n        \n        .box-content {\n            padding: 5mm 3mm 3mm 3mm;\n            min-height: 20mm;\n        }\n        \n        .party-name {\n            font-size: 11pt;\n            font-weight: bold;\n            margin-bottom: 2mm;\n        }\n        \n        .party-address {\n            font-size: 9pt;\n            line-height: 1.4;\n        }\n        \n        /* Two Column Layout */\n        .two-col {\n            display: flex;\n            gap: 3mm;\n        }\n        \n        .col {\n            flex: 1;\n        }\n        \n        /* Route Info */\n        .route-box {\n            border: 2px solid #000;\n            padding: 3mm;\n            margin: 2mm 0;\n            background: #f9f9f9;\n        }\n        \n        .route-arrow {\n            text-align: center;\n            font-size: 16pt;\n            font-weight: bold;\n            color: #007bff;\n            margin: 2mm 0;\n        }\n        \n        /* Cargo Details Table */\n        .cargo-table {\n            width: 100%;\n            border-collapse: collapse;\n            border: 2px solid #000;\n            margin: 2mm 0;\n        }\n        \n        .cargo-table th {\n            background: #e0e0e0;\n            border: 1px solid #000;\n            padding: 2mm;\n            font-size: 8pt;\n            font-weight: bold;\n            text-align: left;\n        }\n        \n        .cargo-table td {\n            border: 1px solid #000;\n            padding: 2mm;\n            font-size: 9pt;\n            vertical-align: top;\n        }\n        \n        /* Signature Section */\n        .signature-section {\n            display: flex;\n            gap: 3mm;\n            margin-top: 5mm;\n        }\n        \n        .signature-box {\n            flex: 1;\n            border: 2px solid #000;\n            padding: 3mm;\n            min-height: 25mm;\n        }\n        \n        .sig-title {\n            font-size: 8pt;\n            font-weight: bold;\n            text-transform: uppercase;\n            margin-bottom: 2mm;\n            border-bottom: 1px solid #ccc;\n            padding-bottom: 1mm;\n        }\n        \n        .sig-line {\n            border-top: 1px solid #000;\n            margin-top: 15mm;\n            padding-top: 2mm;\n            font-size: 7pt;\n            text-align: center;\n        }\n        \n        .sig-field {\n            margin-top: 2mm;\n            font-size: 8pt;\n        }\n        \n        .sig-label {\n            font-size: 7pt;\n            color: #666;\n        }\n        \n        /* Notes Section */\n        .notes-box {\n            border: 2px solid #000;\n            padding: 3mm;\n            margin: 2mm 0;\n            min-height: 15mm;\n        }\n        \n        .notes-title {\n            font-size: 8pt;\n            font-weight: bold;\n            margin-bottom: 2mm;\n        }\n        \n        .notes-content {\n            font-size: 8pt;\n            line-height: 1.4;\n        }\n        \n        /* Footer */\n        .waybill-footer {\n            text-align: center;\n            font-size: 7pt;\n            color: #666;\n            margin-top: 5mm;\n            padding-top: 2mm;\n            border-top: 1px solid #ccc;\n        }\n        \n        .badge {\n            display: inline-block;\n            padding: 1mm 3mm;\n            background: #007bff;\n            color: white;\n            font-size: 7pt;\n            font-weight: bold;\n            border-radius: 2mm;\n            margin: 0 2mm;\n        }\n        \n        .badge-warning {\n            background: #ffc107;\n            color: #000;\n        }\n        \n        .badge-danger {\n            background: #dc3545;\n        }\n        \n        @media print {\n            body { margin: 0; padding: 0; }\n            .waybill-document { margin: 0; padding: 0; max-width: 100%; }\n            @page { size: A4; margin: 5mm; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"waybill-document\">\n        <!-- Header -->\n        <div class=\"waybill-header\">\n            <div class=\"waybill-title\">WAYBILL / CONSIGNMENT NOTE</div>\n            <div class=\"waybill-subtitle\">Road Transport Document</div>\n        </div>\n        \n        <!-- Waybill Number and Date -->\n        <div class=\"info-bar\">\n            <div class=\"info-item\">\n                <div class=\"info-label\">Waybill Number</div>\n                <div class=\"info-value\">{{ doc.name }}</div>\n            </div>\n            <div class=\"info-item\" style=\"text-align: center;\">\n                <div class=\"info-label\">Date</div>\n                <div class=\"info-value\">\n                    {% if doc.date %}\n                        {{ frappe.utils.formatdate(doc.date, 'dd MMM yyyy') }}\n                    {% endif %}\n                </div>\n            </div>\n            <div class=\"info-item\" style=\"text-align: right;\">\n                <div class=\"info-label\">Status</div>\n                <div class=\"info-value\">{{ doc.status or 'Open' }}</div>\n            </div>\n        </div>\n        \n        <!-- Transport Job Number -->\n        {% if doc.transport_job %}\n        <div style=\"text-align: center; margin-bottom: 3mm; font-size: 9pt;\">\n            <strong>Transport Job:</strong> {{ doc.transport_job }}\n            {% if doc.run_sheet %}\n                | <strong>Run Sheet:</strong> {{ doc.run_sheet }}\n            {% endif %}\n        </div>\n        {% endif %}\n        \n        <!-- Special Handling Badges -->\n        <div style=\"text-align: center; margin-bottom: 3mm;\">\n            {% if doc.contains_dangerous_goods %}\n                <span class=\"badge badge-danger\">⚠ HAZARDOUS</span>\n            {% endif %}\n{% if doc.refrigeration %}\n                <span class=\"badge badge-warning\">❄ REFRIGERATED</span>\n            {% endif %}\n{% if doc.priority %}\n                <span class=\"badge\">⚡ PRIORITY: {{ doc.priority }}</span>\n            {% endif %}\n        </div>\n        \n        <!-- Shipper and Consignee -->\n        <div class=\"two-col\">\n            <div class=\"col\">\n                <div class=\"box\">\n                    <div class=\"box-label\">Shipper / From</div>\n                    <div class=\"box-content\">\n                        {% if doc.facility_from %}\n                            <div class=\"party-name\">{{ doc.facility_from }}</div>\n                        {% endif %}\n{% if doc.pick_address_format %}\n                            <div class=\"party-address\">{{ doc.pick_address_format|replace('\\n', '<br>')|safe }}</div>\n                        {% elif doc.pick_address %}\n                            <div class=\"party-address\">{{ doc.pick_address }}</div>\n                        {% endif %}\n{% if doc.pick_mode %}\n                            <div style=\"margin-top: 2mm; font-size: 8pt; color: #666;\">\n                                <strong>Mode:</strong> {{ doc.pick_mode }}\n                            </div>\n                        {% endif %}\n{% if doc.pick_window_start or doc.pick_window_end %}\n                            <div style=\"margin-top: 1mm; font-size: 8pt; color: #666;\">\n                                <strong>Window:</strong> \n                                {% if doc.pick_window_start %}{{ frappe.utils.format_time(doc.pick_window_start) }}{% endif %}\n{% if doc.pick_window_end %} - {{ frappe.utils.format_time(doc.pick_window_end) }}{% endif %}\n                            </div>\n                        {% endif %}\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"col\">\n                <div class=\"box\">\n                    <div class=\"box-label\">Consignee / To</div>\n                    <div class=\"box-content\">\n                        {% if doc.facility_to %}\n                            <div class=\"party-name\">{{ doc.facility_to }}</div>\n                        {% endif %}\n{% if doc.drop_address_html %}\n                            <div class=\"party-address\">{{ doc.drop_address_html|replace('\\n', '<br>')|safe }}</div>\n                        {% elif doc.drop_address %}\n                            <div class=\"party-address\">{{ doc.drop_address }}</div>\n                        {% endif %}\n{% if doc.drop_mode %}\n                            <div style=\"margin-top: 2mm; font-size: 8pt; color: #666;\">\n                                <strong>Mode:</strong> {{ doc.drop_mode }}\n                            </div>\n                        {% endif %}\n{% if doc.drop_window_start or doc.drop_window_end %}\n                            <div style=\"margin-top: 1mm; font-size: 8pt; color: #666;\">\n                                <strong>Window:</strong> \n                                {% if doc.drop_window_start %}{{ frappe.utils.format_time(doc.drop_window_start) }}{% endif %}\n{% if doc.drop_window_end %} - {{ frappe.utils.format_time(doc.drop_window_end) }}{% endif %}\n                            </div>\n                        {% endif %}\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Route Arrow -->\n        <div class=\"route-arrow\">\n            {{ doc.facility_from or 'Origin' }} ➜ {{ doc.facility_to or 'Destination' }}\n        </div>\n        \n        <!-- Route Information -->\n        <div class=\"route-box\">\n            <table style=\"width: 100%; font-size: 9pt;\">\n                <tr>\n                    <td style=\"width: 25%;\"><strong>Distance:</strong></td>\n                    <td style=\"width: 25%;\">\n                        {% if doc.actual_distance_km %}\n                            {{ \"%.1f\" | format(doc.actual_distance_km) }} km\n                        {% elif doc.distance_km %}\n                            {{ \"%.1f\" | format(doc.distance_km) }} km (Est.)\n                        {% else %}\n                            —\n                        {% endif %}\n                    </td>\n                    <td style=\"width: 25%;\"><strong>Duration:</strong></td>\n                    <td style=\"width: 25%;\">\n                        {% if doc.actual_duration_min %}\n                            {{ \"%.0f\" | format(doc.actual_duration_min) }} min\n                        {% elif doc.duration_min %}\n                            {{ \"%.0f\" | format(doc.duration_min) }} min (Est.)\n                        {% else %}\n                            —\n                        {% endif %}\n                    </td>\n                </tr>\n                <tr>\n                    <td><strong>Vehicle Type:</strong></td>\n                    <td>{{ doc.vehicle_type or '—' }}</td>\n                    <td><strong>Cargo Weight:</strong></td>\n                    <td>\n                        {% if doc.cargo_weight_kg %}\n                            {{ \"%.1f\" | format(doc.cargo_weight_kg) }} kg\n                        {% else %}\n                            —\n                        {% endif %}\n                    </td>\n                </tr>\n                {% if doc.start_date or doc.end_date %}\n                <tr>\n                    <td><strong>Departure:</strong></td>\n                    <td>\n                        {% if doc.start_date %}\n                            {{ frappe.utils.format_datetime(doc.start_date, 'dd MMM yyyy HH:mm') }}\n                        {% else %}\n                            —\n                        {% endif %}\n                    </td>\n                    <td><strong>Arrival:</strong></td>\n                    <td>\n                        {% if doc.end_date %}\n                            {{ frappe.utils.format_datetime(doc.end_date, 'dd MMM yyyy HH:mm') }}\n                        {% else %}\n                            —\n                        {% endif %}\n                    </td>\n                </tr>\n                {% endif %}\n            </table>\n        </div>\n        \n        <!-- Cargo Details -->\n        <table class=\"cargo-table\">\n            <thead>\n                <tr>\n                    <th style=\"width: 15%;\">Order</th>\n                    <th style=\"width: 20%;\">Type</th>\n                    <th style=\"width: 20%;\">Vehicle Type</th>\n                    <th style=\"width: 15%;\">Weight (kg)</th>\n                    <th style=\"width: 30%;\">Special Instructions</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>{{ doc.order or '—' }}</td>\n                    <td>{{ doc.facility_type_from or '—' }} → {{ doc.facility_type_to or '—' }}</td>\n                    <td>{{ doc.vehicle_type or '—' }}</td>\n                    <td>\n                        {% if doc.cargo_weight_kg %}\n                            {{ \"%.1f\" | format(doc.cargo_weight_kg) }}\n                        {% else %}\n                            —\n                        {% endif %}\n                    </td>\n                    <td>\n                        {% if doc.contains_dangerous_goods %}HAZARDOUS | {% endif %}\n{% if doc.refrigeration %}REFRIGERATED | {% endif %}\n{% if doc.priority %}PRIORITY: {{ doc.priority }}{% endif %}\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n        \n        <!-- Notes/Instructions -->\n        <div class=\"notes-box\">\n            <div class=\"notes-title\">Instructions / Notes</div>\n            <div class=\"notes-content\">\n                {% if doc.pick_mode or doc.drop_mode %}\n                    <strong>Pickup Mode:</strong> {{ doc.pick_mode or 'Standard' }} | \n                    <strong>Drop Mode:</strong> {{ doc.drop_mode or 'Standard' }}\n                {% endif %}\n            </div>\n        </div>\n        \n        <!-- Signature Section -->\n        <div class=\"signature-section\">\n            <div class=\"signature-box\">\n                <div class=\"sig-title\">Sender / Shipper</div>\n                <div class=\"sig-line\">Signature</div>\n                <div class=\"sig-field\">\n                    <span class=\"sig-label\">Name:</span> _______________________\n                </div>\n                <div class=\"sig-field\">\n                    <span class=\"sig-label\">Date/Time:</span> _______________________\n                </div>\n            </div>\n            \n            <div class=\"signature-box\">\n                <div class=\"sig-title\">Driver / Carrier</div>\n                <div class=\"sig-line\">Signature</div>\n                <div class=\"sig-field\">\n                    <span class=\"sig-label\">Name:</span> _______________________\n                </div>\n                <div class=\"sig-field\">\n                    <span class=\"sig-label\">Date/Time:</span> _______________________\n                </div>\n            </div>\n            \n            <div class=\"signature-box\">\n                <div class=\"sig-title\">Receiver / Consignee</div>\n                {% if doc.signature %}\n                    <div style=\"text-align: center; margin: 2mm 0;\">\n                        <img src=\"{{ doc.signature }}\" style=\"max-width: 100%; max-height: 15mm;\" />\n                    </div>\n                {% else %}\n                    <div class=\"sig-line\">Signature</div>\n                {% endif %}\n<div class=\"sig-field\">\n                    <span class=\"sig-label\">Name:</span> {{ doc.signed_by or '_______________________' }}\n                </div>\n                <div class=\"sig-field\">\n                    <span class=\"sig-label\">Date/Time:</span> \n                    {% if doc.date_signed %}\n                        {{ frappe.utils.format_datetime(doc.date_signed, 'dd MMM yyyy HH:mm') }}\n                    {% else %}\n                        _______________________\n                    {% endif %}\n                </div>\n            </div>\n        </div>\n        \n        <!-- Terms and Conditions -->\n        <div style=\"margin-top: 5mm; padding: 2mm; background: #f9f9f9; border: 1px solid #ccc; font-size: 7pt; line-height: 1.4;\">\n            <strong>Terms and Conditions:</strong> The carrier is not liable for any loss or damage of goods during transit unless caused by carrier's negligence. \n            Claims must be made within 7 days of delivery. The carrier's liability is limited to the declared value of goods or $100 per kg, whichever is lower.\n        </div>\n        \n        <!-- Footer -->\n        <div class=\"waybill-footer\">\n            <div>Waybill Number: <strong>{{ doc.name }}</strong></div>\n            <div style=\"margin-top: 1mm;\">\n                Generated on {{ frappe.utils.format_datetime(frappe.utils.now(), 'dd MMM yyyy HH:mm') }}\n            </div>\n        </div>\n    </div>\n</body>\n</html>\n\n",
