{
 "align_labels_right": 0,
 "creation": "2026-04-21 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Sea Booking",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 10,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 9pt;\n            line-height: 1.4;\n            color: #000;\n            background: white;\n        }\n\n        .order-container {\n            width: 100%;\n            max-width: 210mm;\n            margin: 0 auto;\n            padding: 0;\n            background: white;\n            display: flex;\n            flex-direction: column;\n            min-height: 100vh;\n            position: relative;\n        }\n\n        .top-section {\n            flex: 0 0 auto;\n        }\n\n        .bottom-section {\n            margin-top: auto;\n            flex: 0 0 auto;\n        }\n\n        .header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 3mm;\n        }\n\n        .logo-placeholder {\n            width: 60mm;\n            height: 30mm;\n            background: #e0e0e0;\n            border: 1px solid #ccc;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 7pt;\n            color: #666;\n        }\n\n        .company-logo {\n            width: 60mm;\n            height: 30mm;\n            object-fit: contain;\n        }\n\n        .company-info {\n            flex: 1;\n            text-align: left;\n            padding-left: 3mm;\n        }\n\n        .company-name {\n            font-size: 12pt;\n            font-weight: bold;\n            margin-bottom: 0;\n        }\n\n        .company-address {\n            font-size: 7pt;\n            line-height: 1.3;\n            margin-bottom: 0;\n        }\n\n        .vat-reg {\n            font-size: 7pt;\n        }\n\n        .main-body {\n            display: flex;\n            justify-content: space-between;\n            margin-bottom: 0;\n            margin-top: 35mm;\n            border: 2px solid #000;\n            padding: 1.5mm;\n            position: relative;\n        }\n\n        .left-column {\n            flex: 1;\n            padding-right: 5mm;\n        }\n\n        .right-column {\n            flex: 1;\n            padding-left: 5mm;\n        }\n\n        .field-row {\n            display: flex;\n            margin-bottom: -1mm;\n            align-items: flex-start;\n            gap: 0.3mm;\n        }\n\n        .field-label {\n            font-weight: 900;\n            min-width: 28mm;\n            font-size: 8pt;\n            flex-shrink: 0;\n            text-align: right;\n        }\n\n        .left-column .field-label {\n            text-align: right;\n            min-width: 22mm;\n        }\n\n        .left-column .field-row {\n            gap: 0.1mm;\n        }\n\n        .field-value {\n            flex: 1;\n            font-size: 8pt;\n            min-height: 5mm;\n            padding: 0.3mm 0.5mm;\n            background: white;\n        }\n\n        .customer-info-section {\n            position: absolute;\n            top: -35mm;\n            left: 1.5mm;\n            z-index: 10;\n            max-width: 80mm;\n        }\n\n        .customer-label {\n            font-weight: bold;\n            font-size: 8pt;\n            margin-top: 5mm;\n            margin-bottom: 1mm;\n            line-height: 1;\n        }\n\n        .customer-name-box {\n            padding: 0.3mm 0.5mm;\n            font-size: 12pt;\n            font-weight: 900;\n            margin-bottom: 0.1mm;\n            margin-top: -1mm;\n            line-height: 1;\n            background: white;\n        }\n\n        .customer-address-box {\n            padding: 0.3mm 0.5mm;\n            font-size: 8pt;\n            background: white;\n            width: 100mm;\n        }\n\n        .qr-section {\n            position: absolute;\n            top: -35mm;\n            right: 1.5mm;\n            text-align: right;\n            z-index: 10;\n            margin-bottom: 30mm;\n        }\n\n        .qr-code {\n            width: 20mm;\n            height: 20mm;\n            border: 0 solid #000;\n        }\n\n        .order-title-qr {\n            font-size: 16pt;\n            font-weight: 900;\n            margin-top: 0.11mm;\n            margin-bottom: -1mm;\n            text-align: right;\n        }\n\n        .reference-number {\n            font-size: 8pt;\n            font-weight: normal;\n            margin-top: 0.1mm;\n        }\n\n        .packages-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-top: 0;\n            margin-bottom: 0;\n        }\n\n        .packages-table .table-header {\n            background: #e0e0e0;\n            border: 2px solid #000;\n        }\n\n        .packages-table .table-header th {\n            padding: 0.3mm 0.5mm;\n            text-align: left;\n            font-size: 7pt;\n            font-weight: bold;\n            color: #000;\n            border-top: 2px solid #000;\n            border-bottom: 2px solid #000;\n            border-left: none;\n            border-right: none;\n        }\n\n        .packages-table .table-header th:first-child {\n            border-left: 2px solid #000;\n        }\n\n        .packages-table .table-header th:last-child {\n            border-right: 2px solid #000;\n        }\n\n        .packages-table .table-header th.num,\n        .packages-table .table-row td.num {\n            text-align: right;\n        }\n\n        .packages-table .table-row td {\n            padding: 0.3mm 0.5mm;\n            font-size: 7pt;\n            background: white;\n            border: none;\n            border-bottom: 1px solid #ddd;\n            vertical-align: top;\n        }\n\n        .footer-section {\n            margin-top: 10mm;\n            padding-top: 2mm;\n            padding-bottom: 1mm;\n            border-top: 2px solid #000;\n            font-size: 7pt;\n            background: white;\n            display: block;\n            visibility: visible;\n            page-break-inside: avoid;\n        }\n\n        @page {\n            size: A4;\n            margin: 12mm 12mm 20mm 12mm;\n        }\n\n        @media print {\n            body {\n                margin: 0;\n                padding: 0;\n            }\n            .order-container {\n                padding: 0;\n                padding-bottom: 30mm;\n                max-width: 100%;\n            }\n            .footer-section {\n                position: fixed;\n                bottom: 0;\n                left: 0;\n                right: 0;\n                width: 100%;\n                background: white;\n                padding-top: 2mm;\n                padding-bottom: 2mm;\n                padding-left: 12mm;\n                padding-right: 12mm;\n                border-top: 2px solid #000;\n                margin: 0;\n                box-sizing: border-box;\n                z-index: 1000;\n            }\n        }\n    </style>\n</head>\n<body>\n\n{% set default_company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") or frappe.db.get_default(\"company\") %}\n{% set company_doc = None %}\n{% if doc.company and frappe.db.exists(\"Company\", doc.company) %}\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n{% elif default_company and frappe.db.exists(\"Company\", default_company) %}\n{% set company_doc = frappe.get_doc(\"Company\", default_company) %}\n{% endif %}\n<div class=\"order-container\">\n        <div class=\"header\">\n            {% if company_doc %}\n            {% if company_doc.company_logo %}\n                <img src=\"{{ company_doc.company_logo }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% elif company_doc.logo %}\n                <img src=\"{{ company_doc.logo }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% elif company_doc.image %}\n                <img src=\"{{ company_doc.image }}\" alt=\"Company Logo\" class=\"company-logo\" />\n            {% else %}\n                <div class=\"logo-placeholder\">company_logo</div>\n            {% endif %}\n<div class=\"company-info\">\n                <div class=\"company-name\">{{ company_doc.company_name or doc.company }}</div>\n                <div class=\"company-address\">\n                    {% if company_doc.address %}\n                        {% set company_address = frappe.get_doc(\"Address\", company_doc.address) %}\n                        {{ company_address.address_line1 or '' }}\n                        {% if company_address.address_line2 %}{{ company_address.address_line2 }}{% endif %}\n{% if company_address.city %}{{ company_address.city }}{% endif %}\n{% if company_address.state %}, {{ company_address.state }}{% endif %}\n{% if company_address.country %}{{ company_address.country }}{% endif %}\n{% if company_address.pincode %} {{ company_address.pincode }}{% endif %}\n                    {% elif company_doc.address_line1 %}\n                        {{ company_doc.address_line1 }}<br>\n                        {% if company_doc.address_line2 %}{{ company_doc.address_line2 }}<br>{% endif %}\n                        {{ company_doc.city }}{% if company_doc.state %}, {{ company_doc.state }}{% endif %}<br>\n                        {{ company_doc.country }}{% if company_doc.pincode %} {{ company_doc.pincode }}{% endif %}\n                    {% endif %}\n                </div>\n                <div class=\"vat-reg\">\n                    {% if doc.branch %}\n                        {% set branch_doc = frappe.get_doc(\"Branch\", doc.branch) %}\n                        {% if branch_doc.custom_registration_details %}\n                            {{ branch_doc.custom_registration_details }}\n                        {% elif company_doc.tax_id %}\n                            VAT Reg. TIN: {{ company_doc.tax_id }}\n                        {% elif company_doc.tin %}\n                            VAT Reg. TIN: {{ company_doc.tin }}\n                        {% endif %}\n                    {% elif company_doc.tax_id %}\n                        VAT Reg. TIN: {{ company_doc.tax_id }}\n                    {% elif company_doc.tin %}\n                        VAT Reg. TIN: {{ company_doc.tin }}\n                    {% endif %}\n                </div>\n            </div>\n            {% else %}\n                <div class=\"logo-placeholder\">company_logo</div>\n                <div class=\"company-info\">\n                    <div class=\"company-name\">{{ doc.company or default_company or '' }}</div>\n                </div>\n            {% endif %}\n        </div>\n\n        <div class=\"top-section\">\n        <div class=\"main-body\">\n            <div class=\"customer-info-section\">\n                <div class=\"customer-label\">LOCAL CUSTOMER</div>\n                <div class=\"customer-name-box\">\n                    {% if doc.local_customer %}\n                        {% set cust = frappe.get_doc(\"Customer\", doc.local_customer) %}\n                        {{ cust.customer_name or doc.local_customer }}\n                    {% endif %}\n                </div>\n                <div class=\"customer-address-box\">\n                    {% if doc.local_customer %}\n                        {% set cust = frappe.get_doc(\"Customer\", doc.local_customer) %}\n                        {% if cust.customer_primary_address %}\n                            {% set addr = frappe.get_doc(\"Address\", cust.customer_primary_address) %}\n                            {{ addr.address_line1 or '' }}\n                            {% if addr.address_line2 %} {{ addr.address_line2 }}{% endif %}\n{% if addr.city %} {{ addr.city }}{% endif %}\n{% if addr.state %}, {{ addr.state }}{% endif %}\n{% if addr.country %} {{ addr.country }}{% endif %}\n{% if addr.pincode %} {{ addr.pincode }}{% endif %}\n                        {% endif %}\n                    {% endif %}\n                </div>\n            </div>\n\n            <div class=\"qr-section\">\n                {% set qr_url = 'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + doc.name|urlencode %}\n                <img src=\"{{ qr_url }}\" alt=\"QR Code\" class=\"qr-code\" />\n                <div class=\"order-title-qr\">SEA BOOKING</div>\n                <div class=\"reference-number\">{{ doc.name }}</div>\n            </div>\n\n            <div class=\"left-column\">\n                <div class=\"field-row\">\n                    <div class=\"field-label\">DIRECTION:</div>\n                    <div class=\"field-value\">{{ doc.direction or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">SHIPPING STATUS:</div>\n                    <div class=\"field-value\">{{ doc.shipping_status or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">MASTER BILL:</div>\n                    <div class=\"field-value\">{{ doc.master_bill or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">HOUSE B/L:</div>\n                    <div class=\"field-value\">{{ doc.house_bl or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">HOUSE TYPE:</div>\n                    <div class=\"field-value\">{{ doc.house_type or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">FREIGHT AGENT:</div>\n                    <div class=\"field-value\">{{ doc.freight_agent or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">FREIGHT CONSOL.:</div>\n                    <div class=\"field-value\">{{ doc.freight_consolidator or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">ORIGIN PORT:</div>\n                    <div class=\"field-value\">{{ doc.origin_port or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">DEST. PORT:</div>\n                    <div class=\"field-value\">{{ doc.destination_port or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">ORIGIN CTO:</div>\n                    <div class=\"field-value\">{{ doc.origin_cto or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">DEST. CTO:</div>\n                    <div class=\"field-value\">{{ doc.destination_cto or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">BROKER:</div>\n                    <div class=\"field-value\">{{ doc.broker or '' }}</div>\n                </div>\n            </div>\n\n            <div class=\"right-column\">\n                <div class=\"field-row\">\n                    <div class=\"field-label\">BOOKING DATE:</div>\n                    <div class=\"field-value\">\n                        {% if doc.booking_date %}\n                            {{ frappe.utils.formatdate(doc.booking_date, 'MM-dd-yyyy') }}\n                        {% endif %}\n                    </div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">SHIPPING LINE:</div>\n                    <div class=\"field-value\">{{ doc.shipping_line or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">INCOTERM:</div>\n                    <div class=\"field-value\">{{ doc.incoterm or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">ADD. TERMS:</div>\n                    <div class=\"field-value\">{{ doc.additional_terms or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">LOAD TYPE:</div>\n                    <div class=\"field-value\">{{ doc.load_type or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">RELEASE TYPE:</div>\n                    <div class=\"field-value\">{{ doc.release_type or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">ENTRY TYPE:</div>\n                    <div class=\"field-value\">{{ doc.entry_type or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">ETD:</div>\n                    <div class=\"field-value\">\n                        {% if doc.etd %}{{ frappe.utils.formatdate(doc.etd, 'MM-dd-yyyy') }}{% endif %}\n                    </div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">ETA:</div>\n                    <div class=\"field-value\">\n                        {% if doc.eta %}{{ frappe.utils.formatdate(doc.eta, 'MM-dd-yyyy') }}{% endif %}\n                    </div>\n                </div>\n                {% if doc.atd %}\n                <div class=\"field-row\">\n                    <div class=\"field-label\">ATD:</div>\n                    <div class=\"field-value\">{{ frappe.utils.formatdate(doc.atd, 'MM-dd-yyyy') }}</div>\n                </div>\n                {% endif %}\n{% if doc.ata %}\n                <div class=\"field-row\">\n                    <div class=\"field-label\">ATA:</div>\n                    <div class=\"field-value\">{{ frappe.utils.formatdate(doc.ata, 'MM-dd-yyyy') }}</div>\n                </div>\n                {% endif %}\n<div class=\"field-row\">\n                    <div class=\"field-label\">SENDING AGENT:</div>\n                    <div class=\"field-value\">{{ doc.sending_agent or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">RECEIVING AGENT:</div>\n                    <div class=\"field-value\">{{ doc.receiving_agent or '' }}</div>\n                </div>\n                <div class=\"field-row\">\n                    <div class=\"field-label\">TRANSPORT MODE:</div>\n                    <div class=\"field-value\">{{ doc.transport_mode or '' }}</div>\n                </div>\n            </div>\n        </div>\n\n        <table class=\"packages-table\">\n            <thead class=\"table-header\">\n                <tr>\n                    <th>COMMODITY</th>\n                    <th>HS CODE</th>\n                    <th>REF NO</th>\n                    <th>CONTAINER</th>\n                    <th class=\"num\">PACKS</th>\n                    <th>UOM</th>\n                    <th class=\"num\">WEIGHT</th>\n                    <th class=\"num\">VOLUME</th>\n                    <th>DIM (L×W×H)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% if doc.packages %}\n                    {% for row in doc.packages %}\n                        <tr class=\"table-row\">\n                            <td>{{ row.commodity or '' }}</td>\n                            <td>{{ row.hs_code or '' }}</td>\n                            <td>{{ row.reference_no or '' }}</td>\n                            <td>{{ row.container or '' }}</td>\n                            <td class=\"num\">{% if row.no_of_packs is not none %}{{ frappe.utils.fmt_money(row.no_of_packs, precision=3) }}{% endif %}</td>\n                            <td>{{ row.uom or '' }}</td>\n                            <td class=\"num\">\n                                {% if row.weight is not none %}\n                                    {{ frappe.utils.fmt_money(row.weight, precision=3) }}{% if row.weight_uom %} {{ row.weight_uom }}{% endif %}\n                                {% endif %}\n                            </td>\n                            <td class=\"num\">\n                                {% if row.volume is not none %}\n                                    {{ frappe.utils.fmt_money(row.volume, precision=3) }}{% if row.volume_uom %} {{ row.volume_uom }}{% endif %}\n                                {% endif %}\n                            </td>\n                            <td>\n                                {% if row.length or row.width or row.height %}\n                                    {% if row.length is not none %}{{ frappe.utils.fmt_money(row.length, precision=2) }}{% endif %}×\n                                    {% if row.width is not none %}{{ frappe.utils.fmt_money(row.width, precision=2) }}{% endif %}×\n                                    {% if row.height is not none %}{{ frappe.utils.fmt_money(row.height, precision=2) }}{% endif %}\n{% if row.dimension_uom %} {{ row.dimension_uom }}{% endif %}\n                                {% endif %}\n                            </td>\n                        </tr>\n                    {% endfor %}\n                {% else %}\n                    <tr class=\"table-row\">\n                        <td colspan=\"9\" style=\"text-align: center; padding: 5mm;\">No packages</td>\n                    </tr>\n                {% endif %}\n            </tbody>\n        </table>\n        </div>\n\n        <div class=\"bottom-section\">\n        <div class=\"footer-section\">\n            <div>Company: {{ doc.company or '' }}</div>\n            {% if doc.branch %}<div>Branch: {{ doc.branch }}</div>{% endif %}\n{% if doc.cost_center %}<div>Cost Center: {{ doc.cost_center }}</div>{% endif %}\n{% if doc.profit_center %}<div>Profit Center: {{ doc.profit_center }}</div>{% endif %}\n        </div>\n        </div>\n    </div>\n</body>\n</html>\n",
