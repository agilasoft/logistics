{
 "align_labels_right": 0,
 "creation": "2025-01-01 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 8,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        body {\n            font-family: 'Arial', 'Helvetica', sans-serif;\n            font-size: 8pt;\n            line-height: 1.2;\n            color: #000;\n            background: white;\n        }\n        \n        .invoice-container {\n            width: 100%;\n            max-width: 210mm;\n            margin: 0 auto;\n            padding: 5mm;\n            background: white;\n        }\n        \n        /* Header Section */\n        .header {\n            display: flex;\n            justify-content: space-between;\n            border-bottom: 2px solid #000;\n            padding-bottom: 3mm;\n            margin-bottom: 3mm;\n        }\n        \n        .company-info {\n            flex: 1;\n        }\n        \n        .company-name {\n            font-size: 14pt;\n            font-weight: bold;\n            margin-bottom: 1mm;\n        }\n        \n        .company-details {\n            font-size: 7pt;\n            line-height: 1.3;\n        }\n        \n        .invoice-title {\n            text-align: center;\n            font-size: 16pt;\n            font-weight: bold;\n            margin-bottom: 2mm;\n        }\n        \n        .invoice-number-section {\n            text-align: right;\n            font-size: 8pt;\n        }\n        \n        .invoice-number {\n            font-size: 10pt;\n            font-weight: bold;\n        }\n        \n        /* Document Info Section */\n        .doc-info {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 2mm;\n            margin-bottom: 3mm;\n            font-size: 7pt;\n        }\n        \n        .info-row {\n            display: flex;\n            margin-bottom: 1mm;\n        }\n        \n        .info-label {\n            font-weight: bold;\n            min-width: 35mm;\n        }\n        \n        .info-value {\n            flex: 1;\n        }\n        \n        /* Party Information */\n        .party-section {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 3mm;\n            margin-bottom: 3mm;\n        }\n        \n        .party-box {\n            border: 1px solid #000;\n            padding: 2mm;\n            font-size: 7pt;\n        }\n        \n        .party-title {\n            font-weight: bold;\n            border-bottom: 1px solid #000;\n            padding-bottom: 1mm;\n            margin-bottom: 1mm;\n        }\n        \n        .party-details {\n            line-height: 1.4;\n        }\n        \n        .tin-info {\n            margin-top: 1mm;\n            font-size: 6pt;\n        }\n        \n        /* Items Table */\n        .items-table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 3mm;\n            font-size: 7pt;\n        }\n        \n        .items-table thead {\n            background-color: #f0f0f0;\n        }\n        \n        .items-table th {\n            border: 1px solid #000;\n            padding: 2mm;\n            text-align: left;\n            font-weight: bold;\n        }\n        \n        .items-table td {\n            border: 1px solid #000;\n            padding: 1.5mm;\n        }\n        \n        .items-table .text-right {\n            text-align: right;\n        }\n        \n        .items-table .text-center {\n            text-align: center;\n        }\n        \n        .col-item { width: 8%; }\n        .col-description { width: 35%; }\n        .col-qty { width: 8%; }\n        .col-uom { width: 8%; }\n        .col-rate { width: 12%; }\n        .col-amount { width: 12%; }\n        .col-tax { width: 8%; }\n        \n        /* Totals Section */\n        .totals-section {\n            display: flex;\n            justify-content: flex-end;\n            margin-bottom: 3mm;\n        }\n        \n        .totals-table {\n            width: 45%;\n            border-collapse: collapse;\n            font-size: 7pt;\n        }\n        \n        .totals-table td {\n            padding: 1mm 2mm;\n            border: 1px solid #000;\n        }\n        \n        .totals-table .label {\n            text-align: right;\n            font-weight: bold;\n            background-color: #f0f0f0;\n        }\n        \n        .totals-table .value {\n            text-align: right;\n        }\n        \n        .totals-table .total-row {\n            font-weight: bold;\n            font-size: 9pt;\n            background-color: #e0e0e0;\n        }\n        \n        /* Tax Details */\n        .tax-details {\n            margin-top: 2mm;\n            font-size: 6pt;\n            border-top: 1px solid #000;\n            padding-top: 1mm;\n        }\n        \n        .tax-row {\n            display: flex;\n            justify-content: space-between;\n            margin-bottom: 0.5mm;\n        }\n        \n        /* Footer */\n        .footer {\n            margin-top: 5mm;\n            padding-top: 2mm;\n            border-top: 1px solid #000;\n            font-size: 6pt;\n        }\n        \n        .footer-row {\n            display: flex;\n            justify-content: space-between;\n            margin-bottom: 1mm;\n        }\n        \n        .signature-section {\n            margin-top: 5mm;\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 5mm;\n        }\n        \n        .signature-box {\n            text-align: center;\n            font-size: 7pt;\n        }\n        \n        .signature-line {\n            border-top: 1px solid #000;\n            margin-top: 15mm;\n            padding-top: 1mm;\n        }\n        \n        /* BIR Compliance Notes */\n        .bir-note {\n            font-size: 5pt;\n            text-align: center;\n            margin-top: 2mm;\n            font-style: italic;\n        }\n        \n        @media print {\n            body {\n                margin: 0;\n                padding: 0;\n            }\n            .invoice-container {\n                padding: 3mm;\n            }\n            .page-break {\n                page-break-after: always;\n            }\n        }\n    </style>\n</head>\n<body>\n{% set default_company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") or frappe.db.get_default(\"company\") %}\n{% set company_doc = None %}\n{% set resolved_company = doc.company or default_company %}\n{% if doc.company and frappe.db.exists(\"Company\", doc.company) %}\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n{% elif default_company and frappe.db.exists(\"Company\", default_company) %}\n{% set company_doc = frappe.get_doc(\"Company\", default_company) %}\n{% endif %}\n<div class=\"invoice-container\">\n        <!-- Header -->\n        <div class=\"header\">\n            <div class=\"company-info\">\n                <div class=\"company-name\">{{ doc.company }}</div>\n                <div class=\"company-details\">\n                    {% if company_doc and company_doc.address %}\n                        {% set company_address = frappe.get_doc(\"Address\", company_doc.address) %}\n                        {{ company_address.address_line1 if company_address.address_line1 else '' }}<br>\n                        {% if company_address.address_line2 %}{{ company_address.address_line2 }}<br>{% endif %}\n                        {{ company_address.city if company_address.city else '' }}{% if company_address.state %}, {{ company_address.state }}{% endif %}<br>\n                    {% elif doc.company_address %}\n                        {{ doc.company_address }}<br>\n                    {% endif %}\n{% if company_doc and company_doc.phone_no %}\n                        Tel: {{ company_doc.phone_no }}<br>\n                    {% endif %}\n{% if company_doc and company_doc.email %}\n                        Email: {{ company_doc.email }}<br>\n                    {% endif %}\n{% if company_doc and company_doc.tin %}\n                        TIN: {{ company_doc.tin }}{% if company_doc.branch_code %}-{{ company_doc.branch_code }}{% endif %}\n                    {% endif %}\n                </div>\n            </div>\n            <div class=\"invoice-number-section\">\n                <div class=\"invoice-title\">SALES INVOICE</div>\n                <div class=\"invoice-number\">No. {{ doc.name }}</div>\n            </div>\n        </div>\n        \n        <!-- Document Info -->\n        <div class=\"doc-info\">\n            <div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Date:</span>\n                    <span class=\"info-value\">\n                        {% if doc.posting_date %}\n                            {{ frappe.format_value(doc.posting_date, {'fieldtype': 'Date'}, doc) }}\n                        {% endif %}\n                    </span>\n                </div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Due Date:</span>\n                    <span class=\"info-value\">\n                        {% if doc.due_date %}\n                            {{ frappe.format_value(doc.due_date, {'fieldtype': 'Date'}, doc) }}\n                        {% endif %}\n                    </span>\n                </div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Customer PO:</span>\n                    <span class=\"info-value\">{{ doc.po_no if doc.po_no else 'N/A' }}</span>\n                </div>\n            </div>\n            <div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Invoice Date:</span>\n                    <span class=\"info-value\">\n                        {% if doc.posting_date %}\n                            {{ frappe.format_value(doc.posting_date, {'fieldtype': 'Date'}, doc) }}\n                        {% endif %}\n                    </span>\n                </div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Terms:</span>\n                    <span class=\"info-value\">{{ doc.payment_terms_template if doc.payment_terms_template else 'N/A' }}</span>\n                </div>\n                <div class=\"info-row\">\n                    <span class=\"info-label\">Reference:</span>\n                    <span class=\"info-value\">{{ doc.name }}</span>\n                </div>\n            </div>\n        </div>\n        \n        <!-- Party Information -->\n        <div class=\"party-section\">\n            <div class=\"party-box\">\n                <div class=\"party-title\">Bill To:</div>\n                <div class=\"party-details\">\n                    <strong>{{ doc.customer_name }}</strong><br>\n                    {% if doc.customer_address %}\n                        {{ doc.customer_address|replace('\\n', '<br>')|safe }}<br>\n                    {% endif %}\n                    {% set customer_doc = frappe.get_doc(\"Customer\", doc.customer) %}\n                    {% if customer_doc.tin %}\n                        <div class=\"tin-info\">TIN: {{ customer_doc.tin }}{% if customer_doc.branch_code %}-{{ customer_doc.branch_code }}{% endif %}</div>\n                    {% endif %}\n                </div>\n            </div>\n            <div class=\"party-box\">\n                <div class=\"party-title\">Ship To:</div>\n                <div class=\"party-details\">\n                    {% if doc.shipping_address_name %}\n                        {% set shipping_address = frappe.get_doc(\"Address\", doc.shipping_address_name) %}\n                        <strong>{{ shipping_address.address_line1 if shipping_address else '' }}</strong><br>\n                        {% if shipping_address %}\n                            {{ shipping_address.address_line2 if shipping_address.address_line2 else '' }}<br>\n                            {{ shipping_address.city if shipping_address.city else '' }}, {{ shipping_address.state if shipping_address.state else '' }}<br>\n                            {{ shipping_address.pincode if shipping_address.pincode else '' }}\n                        {% endif %}\n                    {% else %}\n                        Same as Bill To\n                    {% endif %}\n                </div>\n            </div>\n        </div>\n        \n        <!-- Items Table -->\n        <table class=\"items-table\">\n            <thead>\n                <tr>\n                    <th class=\"col-item\">Item</th>\n                    <th class=\"col-description\">Description</th>\n                    <th class=\"col-qty text-center\">Qty</th>\n                    <th class=\"col-uom\">UOM</th>\n                    <th class=\"col-rate text-right\">Rate</th>\n                    <th class=\"col-amount text-right\">Amount</th>\n                    <th class=\"col-tax text-center\">Tax</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.items %}\n                <tr>\n                    <td>{{ item.item_code }}</td>\n                    <td>{{ item.item_name }}{% if item.description %}<br><small>{{ item.description }}</small>{% endif %}</td>\n                    <td class=\"text-center\">{{ frappe.utils.fmt_money(item.qty, precision=2) }}</td>\n                    <td>{{ item.uom }}</td>\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(item.rate, precision=2, currency=doc.currency) }}</td>\n                    <td class=\"text-right\">{{ frappe.utils.fmt_money(item.amount, precision=2, currency=doc.currency) }}</td>\n                    <td class=\"text-center\">\n                        {% if item.tax_rate %}\n                            {{ frappe.utils.fmt_money(item.tax_rate, precision=2) }}%\n                        {% else %}\n                            -\n                        {% endif %}\n                    </td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n        \n        <!-- Totals -->\n        <div class=\"totals-section\">\n            <table class=\"totals-table\">\n                <tr>\n                    <td class=\"label\">Subtotal:</td>\n                    <td class=\"value\">{{ frappe.utils.fmt_money(doc.net_total - doc.total_taxes_and_charges, precision=2, currency=doc.currency) }}</td>\n                </tr>\n                {% if doc.total_taxes_and_charges %}\n                <tr>\n                    <td class=\"label\">Taxes & Charges:</td>\n                    <td class=\"value\">{{ frappe.utils.fmt_money(doc.total_taxes_and_charges, precision=2, currency=doc.currency) }}</td>\n                </tr>\n                {% endif %}\n{% if doc.discount_amount %}\n                <tr>\n                    <td class=\"label\">Discount:</td>\n                    <td class=\"value\">({{ frappe.utils.fmt_money(doc.discount_amount, precision=2, currency=doc.currency) }})</td>\n                </tr>\n                {% endif %}\n                <tr class=\"total-row\">\n                    <td class=\"label\">Total Amount:</td>\n                    <td class=\"value\">{{ frappe.utils.fmt_money(doc.grand_total, precision=2, currency=doc.currency) }}</td>\n                </tr>\n                {% if doc.currency != doc.company_currency %}\n                <tr>\n                    <td class=\"label\">Exchange Rate:</td>\n                    <td class=\"value\">{{ frappe.utils.fmt_money(doc.conversion_rate, precision=6) }}</td>\n                </tr>\n                <tr>\n                    <td class=\"label\">Total ({{ doc.company_currency }}):</td>\n                    <td class=\"value\">{{ frappe.utils.fmt_money(doc.base_grand_total, precision=2) }}</td>\n                </tr>\n                {% endif %}\n            </table>\n        </div>\n        \n        <!-- Tax Details -->\n        {% if doc.taxes %}\n        <div class=\"tax-details\">\n            <strong>Tax Breakdown:</strong><br>\n            {% for tax in doc.taxes %}\n                {% if tax.tax_amount %}\n                {{ tax.description }}: {{ frappe.utils.fmt_money(tax.tax_amount, precision=2, currency=doc.currency) }}<br>\n                {% endif %}\n            {% endfor %}\n        </div>\n        {% endif %}\n        \n        <!-- Footer -->\n        <div class=\"footer\">\n            {% if doc.terms %}\n            <div class=\"footer-row\">\n                <strong>Terms & Conditions:</strong>\n            </div>\n            <div style=\"margin-bottom: 2mm; font-size: 6pt;\">\n                {{ doc.terms }}\n            </div>\n            {% endif %}\n<div class=\"signature-section\">\n                <div class=\"signature-box\">\n                    <div class=\"signature-line\">Prepared by</div>\n                </div>\n                <div class=\"signature-box\">\n                    <div class=\"signature-line\">Received by</div>\n                </div>\n            </div>\n            \n            <div class=\"bir-note\">\n                This document serves as an official receipt for accounting and tax purposes.\n                {% if company_doc and company_doc.tin %}\n                    TIN: {{ company_doc.tin }}{% if company_doc.branch_code %}-{{ company_doc.branch_code }}{% endif %}\n                {% endif %}\n            </div>\n        </div>\n    </div>\n</body>\n</html>\n\n",
 "idx": 0,
 "line_breaks": 0,
 "modified": "2025-01-01 12:00:00.000000",
 "modified_by": "Administrator",
 "module": "Logistics",
 "name": "BIR Sales Invoice",
