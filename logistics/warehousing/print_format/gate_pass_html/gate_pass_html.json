 "creation": "2026-06-11 09:38:08.566908",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Gate Pass",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        html, body {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 8pt;\n            line-height: 1.25;\n            color: #2d3748;\n            background: #fff;\n        }\n        .gp-page {\n            width: 100%;\n            max-width: 210mm;\n            margin: 0 auto;\n            border: 1.5px solid #8a939c;\n            padding: 3mm;\n        }\n\n        /* Header */\n        .gp-header {\n            display: grid;\n            grid-template-columns: 1fr auto 1fr;\n            align-items: start;\n            gap: 2mm;\n            margin-bottom: 2.5mm;\n            padding-bottom: 2mm;\n            border-bottom: 1px solid #c5ccd3;\n        }\n        .gp-brand { display: flex; gap: 2mm; align-items: flex-start; min-width: 0; }\n        .gp-logo {\n            width: 14mm;\n            height: 14mm;\n            object-fit: contain;\n            flex-shrink: 0;\n        }\n        .gp-logo-ph {\n            width: 14mm;\n            height: 14mm;\n            border: 1px solid #b8c0c8;\n            background: #e8eaed;\n            color: #6c757d;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 14pt;\n            flex-shrink: 0;\n        }\n        .gp-company-name { font-size: 9pt; font-weight: bold; color: #4a5568; line-height: 1.15; }\n        .gp-company-tag { font-size: 6.5pt; color: #718096; margin-top: 0.3mm; }\n        .gp-title {\n            font-size: 18pt;\n            font-weight: 900;\n            letter-spacing: 0.08em;\n            color: #5a6268;\n            text-align: center;\n            align-self: center;\n        }\n        .gp-no-box {\n            justify-self: end;\n            border: 1px solid #8a939c;\n            min-width: 38mm;\n            text-align: center;\n        }\n        .gp-no-lbl {\n            background: #e8eaed;\n            border-bottom: 1px solid #8a939c;\n            font-size: 7pt;\n            font-weight: bold;\n            color: #5a6268;\n            padding: 0.8mm 2mm;\n        }\n        .gp-no-val {\n            font-size: 9pt;\n            font-weight: bold;\n            padding: 1.2mm 2mm;\n            min-height: 6mm;\n        }\n\n        /* Top info grid */\n        .info-grid {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 2.5mm;\n        }\n        .info-grid td {\n            border: 1px solid #b8c0c8;\n            vertical-align: top;\n            padding: 0;\n        }\n        .fld {\n            padding: 1mm 1.5mm;\n            min-height: 9mm;\n        }\n        .fld-lbl {\n            font-size: 6.5pt;\n            font-weight: bold;\n            color: #5a6268;\n            margin-bottom: 0.5mm;\n            display: flex;\n            align-items: center;\n            gap: 1mm;\n        }\n        .fld-val {\n            font-size: 8pt;\n            color: #1a202c;\n            min-height: 3.5mm;\n            word-break: break-word;\n        }\n        .ico {\n            display: inline-flex;\n            width: 3mm;\n            height: 3mm;\n            align-items: center;\n            justify-content: center;\n            font-size: 5.5pt;\n            color: #6c757d;\n            flex-shrink: 0;\n        }\n\n        /* Sections */\n        .section { margin-bottom: 2.5mm; border: 1px solid #b8c0c8; }\n        .sec-head {\n            background: #5a6268;\n            color: #fff;\n            font-size: 7.5pt;\n            font-weight: bold;\n            text-transform: uppercase;\n            letter-spacing: 0.04em;\n            padding: 1.2mm 2mm;\n            display: flex;\n            align-items: center;\n            gap: 2mm;\n        }\n        .sec-num {\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            width: 4.5mm;\n            height: 4.5mm;\n            border: 1px solid rgba(255,255,255,0.85);\n            border-radius: 50%;\n            font-size: 6.5pt;\n            flex-shrink: 0;\n        }\n        .sec-grid {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .sec-grid td {\n            border: 1px solid #d5dbe0;\n            vertical-align: top;\n            padding: 0;\n        }\n\n        /* Items table */\n        .items-t {\n            width: 100%;\n            border-collapse: collapse;\n        }\n        .items-t th {\n            background: #e8eaed;\n            border: 1px solid #b8c0c8;\n            padding: 1mm 1.2mm;\n            font-size: 6.5pt;\n            font-weight: bold;\n            color: #4a5568;\n            text-align: center;\n        }\n        .items-t td {\n            border: 1px solid #d5dbe0;\n            padding: 1mm 1.2mm;\n            font-size: 7pt;\n            vertical-align: top;\n            min-height: 6mm;\n        }\n        .items-t td.num { text-align: center; }\n        .items-t td.qty { text-align: right; }\n\n        /* Status checkboxes */\n        .status-row {\n            display: flex;\n            flex-wrap: wrap;\n            align-items: center;\n            gap: 2mm 3mm;\n            padding: 1mm 0;\n        }\n        .status-opt {\n            display: inline-flex;\n            align-items: center;\n            gap: 1mm;\n            font-size: 7pt;\n        }\n        .chk {\n            width: 3mm;\n            height: 3mm;\n            border: 1px solid #8a939c;\n            display: inline-flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 6pt;\n            font-weight: bold;\n            background: #fff;\n            flex-shrink: 0;\n        }\n        .chk.on { background: #5a6268; color: #fff; }\n\n        /* Notes */\n        .notes-val {\n            font-size: 7.5pt;\n            min-height: 10mm;\n            white-space: pre-wrap;\n            word-break: break-word;\n        }\n\n        /* Footer */\n        .gp-footer {\n            display: grid;\n            grid-template-columns: 1fr auto;\n            gap: 3mm;\n            align-items: end;\n            margin-top: 2mm;\n            padding-top: 2mm;\n            border-top: 1px solid #c5ccd3;\n        }\n        .footer-note {\n            display: flex;\n            gap: 2mm;\n            align-items: flex-start;\n            font-size: 6.5pt;\n            color: #4a5568;\n            line-height: 1.35;\n        }\n        .footer-icon {\n            width: 10mm;\n            height: 10mm;\n            border: 1px solid #b8c0c8;\n            border-radius: 2px;\n            background: #f0f2f4;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 14pt;\n            color: #6c757d;\n            flex-shrink: 0;\n        }\n        .sig-box {\n            border: 1px dashed #8a939c;\n            padding: 2mm 3mm;\n            min-width: 72mm;\n        }\n        .sig-row {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 4mm;\n        }\n        .sig-block { text-align: center; }\n        .sig-line {\n            border-bottom: 1px solid #5a6268;\n            min-height: 10mm;\n            margin-bottom: 1mm;\n            display: flex;\n            align-items: flex-end;\n            justify-content: center;\n            font-size: 7pt;\n            color: #4a5568;\n            padding-bottom: 0.5mm;\n        }\n        .sig-lbl { font-size: 6.5pt; color: #5a6268; font-weight: bold; }\n\n        @page { size: A4; margin: 8mm 10mm; }\n        @media print {\n            html, body { margin: 0; padding: 0; }\n            .gp-page { border: 1.5px solid #8a939c; max-width: 100%; }\n            .sec-head, .chk.on { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n        }\n    </style>\n</head>\n<body>\n\n{% macro fmt_date(val) -%}\n{%- if val -%}{{ frappe.utils.formatdate(val, \"dd-MM-yyyy\") }}{%- endif -%}\n{%- endmacro %}\n\n{% macro fmt_time(val) -%}\n{%- if val -%}{{ frappe.utils.format_time(val) }}{%- endif -%}\n{%- endmacro %}\n\n{% macro fmt_datetime(val) -%}\n{%- if val -%}{{ frappe.utils.format_datetime(val) }}{%- endif -%}\n{%- endmacro %}\n\n{% macro user_name(user) -%}\n{%- if user -%}{{ frappe.db.get_value(\"User\", user, \"full_name\") or user }}{%- endif -%}\n{%- endmacro %}\n\n{% macro customer_name(cust) -%}\n{%- if cust -%}{{ frappe.db.get_value(\"Customer\", cust, \"customer_name\") or cust }}{%- endif -%}\n{%- endmacro %}\n\n{% set default_company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") or frappe.db.get_default(\"company\") %}\n{% set company_doc = None %}\n{% if doc.company and frappe.db.exists(\"Company\", doc.company) %}\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n{% elif default_company and frappe.db.exists(\"Company\", default_company) %}\n{% set company_doc = frappe.get_doc(\"Company\", default_company) %}\n{% endif %}\n\n{% set status_options = [\"Draft\", \"Authorized\", \"In Progress\", \"Completed\", \"Cancelled\"] %}\n{% set item_rows = doc.items or [] %}\n{% set min_item_rows = 5 %}\n{% set item_pad = min_item_rows - (item_rows|length) if (item_rows|length) < min_item_rows else 0 %}\n\n<div class=\"gp-page\">\n\n    <div class=\"gp-header\">\n        <div class=\"gp-brand\">\n            {% if company_doc and company_doc.company_logo %}\n            <img src=\"{{ company_doc.company_logo }}\" alt=\"\" class=\"gp-logo\" />\n            {% elif company_doc and company_doc.logo %}\n            <img src=\"{{ company_doc.logo }}\" alt=\"\" class=\"gp-logo\" />\n            {% else %}\n            <div class=\"gp-logo-ph\">&#8962;</div>\n            {% endif %}\n            <div>\n                <div class=\"gp-company-name\">{{ (company_doc.company_name if company_doc else doc.company) or \"YOUR COMPANY\" }}</div>\n                <div class=\"gp-company-tag\">Moving Logistics Forward</div>\n            </div>\n        </div>\n        <div class=\"gp-title\">GATE PASS</div>\n        <div class=\"gp-no-box\">\n            <div class=\"gp-no-lbl\">GP No.</div>\n            <div class=\"gp-no-val\">{{ doc.name }}</div>\n        </div>\n    </div>\n\n    <table class=\"info-grid\">\n        <tr>\n            <td style=\"width:33.33%\"><div class=\"fld\">\n                <div class=\"fld-lbl\"><span class=\"ico\">&#128197;</span> Gate Pass Date</div>\n                <div class=\"fld-val\">{{ fmt_date(doc.gate_pass_date) }}</div>\n            </div></td>\n            <td style=\"width:33.33%\"><div class=\"fld\">\n                <div class=\"fld-lbl\"><span class=\"ico\">&#128336;</span> Gate Pass Time</div>\n                <div class=\"fld-val\">{{ fmt_time(doc.gate_pass_time) }}</div>\n            </div></td>\n            <td style=\"width:33.34%\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Warehouse Job</div>\n                <div class=\"fld-val\">{{ doc.warehouse_job or \"\" }}</div>\n            </div></td>\n        </tr>\n        <tr>\n            <td colspan=\"1\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Company</div>\n                <div class=\"fld-val\">{{ doc.company or \"\" }}</div>\n            </div></td>\n            <td colspan=\"2\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Branch</div>\n                <div class=\"fld-val\">{{ doc.branch or \"\" }}</div>\n            </div></td>\n        </tr>\n        <tr>\n            <td colspan=\"3\"><div class=\"fld\">\n                <div class=\"fld-lbl\">From Warehouse Job (auto-filled)</div>\n                <div class=\"fld-val\">{{ doc.warehouse_job or \"\" }}{% if doc.reference_order %} &mdash; {{ doc.reference_order_type }}: {{ doc.reference_order }}{% endif %}</div>\n            </div></td>\n        </tr>\n    </table>\n\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">1</span> Gate Pass Details</div>\n        <table class=\"sec-grid\">\n            <tr>\n                <td style=\"width:33.33%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Job Type</div>\n                    <div class=\"fld-val\">{{ doc.job_type or \"\" }}</div>\n                </div></td>\n                <td style=\"width:33.33%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Reference Order Type</div>\n                    <div class=\"fld-val\">{{ doc.reference_order_type or \"\" }}</div>\n                </div></td>\n                <td style=\"width:33.34%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Reference Order</div>\n                    <div class=\"fld-val\">{{ doc.reference_order or \"\" }}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\">Customer</div>\n                    <div class=\"fld-val\">{{ customer_name(doc.customer) }}</div>\n                </div></td>\n                <td colspan=\"2\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Docking / Transport</div>\n                    <div class=\"fld-val\">{{ doc.transport_company or \"\" }}{% if doc.vehicle_type %} &mdash; {{ doc.vehicle_type }}{% endif %}{% if doc.plate_no %} ({{ doc.plate_no }}){% endif %}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\">Dock Door</div>\n                    <div class=\"fld-val\">{{ doc.dock_door or \"\" }}</div>\n                </div></td>\n                <td colspan=\"2\"><div class=\"fld\">\n                    <div class=\"fld-lbl\"><span class=\"ico\">&#128197;</span> <span class=\"ico\">&#128336;</span> ETA</div>\n                    <div class=\"fld-val\">{{ fmt_datetime(doc.eta) }}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\">Transport Company</div>\n                    <div class=\"fld-val\">{{ doc.transport_company or \"\" }}</div>\n                </div></td>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\">Vehicle Type</div>\n                    <div class=\"fld-val\">{{ doc.vehicle_type or \"\" }}</div>\n                </div></td>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\">Plate No.</div>\n                    <div class=\"fld-val\">{{ doc.plate_no or \"\" }}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td colspan=\"2\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Driver Name</div>\n                    <div class=\"fld-val\">{{ doc.driver_name or \"\" }}</div>\n                </div></td>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\">Driver Contact</div>\n                    <div class=\"fld-val\">{{ doc.driver_contact or \"\" }}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\">Container Type</div>\n                    <div class=\"fld-val\">{{ doc.container_type or \"\" }}</div>\n                </div></td>\n                <td colspan=\"2\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Container No.</div>\n                    <div class=\"fld-val\">{{ doc.container_no or \"\" }}</div>\n                </div></td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">2</span> Items</div>\n        <table class=\"items-t\">\n            <thead>\n                <tr>\n                    <th style=\"width:4%\">#</th>\n                    <th style=\"width:12%\">Item Code</th>\n                    <th style=\"width:16%\">Item Name</th>\n                    <th style=\"width:24%\">Description</th>\n                    <th style=\"width:10%\">Quantity</th>\n                    <th style=\"width:8%\">UOM</th>\n                    <th style=\"width:12%\">Branch</th>\n                    <th style=\"width:14%\">Handling Unit</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% if item_rows %}\n                {% for item in item_rows %}\n                <tr>\n                    <td class=\"num\">{{ loop.index }}</td>\n                    <td>{{ item.item_code or \"\" }}</td>\n                    <td>{{ item.item_name or \"\" }}</td>\n                    <td>{{ item.description or \"\" }}</td>\n                    <td class=\"qty\">{% if item.qty is not none %}{{ item.qty }}{% endif %}</td>\n                    <td class=\"num\">{{ item.uom or \"\" }}</td>\n                    <td>{{ item.branch or doc.branch or \"\" }}</td>\n                    <td>{{ item.handling_unit or \"\" }}</td>\n                </tr>\n                {% endfor %}\n                {% else %}\n                <tr>\n                    <td colspan=\"8\" style=\"text-align:center;color:#718096;padding:3mm;\">No items recorded</td>\n                </tr>\n                {% endif %}\n                {% for i in range(item_pad) %}\n                <tr>\n                    <td class=\"num\">&nbsp;</td>\n                    <td>&nbsp;</td>\n                    <td>&nbsp;</td>\n                    <td>&nbsp;</td>\n                    <td>&nbsp;</td>\n                    <td>&nbsp;</td>\n                    <td>&nbsp;</td>\n                    <td>&nbsp;</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">3</span> Authorization</div>\n        <table class=\"sec-grid\">\n            <tr>\n                <td style=\"width:50%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Authorized By</div>\n                    <div class=\"fld-val\">{{ user_name(doc.authorized_by) }}</div>\n                </div></td>\n                <td style=\"width:50%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\"><span class=\"ico\">&#128197;</span> Authorized Date</div>\n                    <div class=\"fld-val\">{{ fmt_date(doc.authorized_date) }}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\">Security Checked By</div>\n                    <div class=\"fld-val\">{{ user_name(doc.security_checked_by) }}</div>\n                </div></td>\n                <td><div class=\"fld\">\n                    <div class=\"fld-lbl\"><span class=\"ico\">&#128336;</span> Security Check Time</div>\n                    <div class=\"fld-val\">{{ fmt_datetime(doc.security_check_time) }}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td colspan=\"2\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Security Notes</div>\n                    <div class=\"fld-val notes-val\">{{ doc.security_notes or \"\" }}</div>\n                </div></td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">4</span> Status / Timeline</div>\n        <table class=\"sec-grid\">\n            <tr>\n                <td colspan=\"2\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Status</div>\n                    <div class=\"status-row\">\n                        {% for opt in status_options %}\n                        <span class=\"status-opt\">\n                            <span class=\"chk{% if doc.status == opt %} on{% endif %}\">{% if doc.status == opt %}&#10003;{% endif %}</span>\n                            {{ opt }}\n                        </span>\n                        {% endfor %}\n                    </div>\n                </div></td>\n            </tr>\n            <tr>\n                <td style=\"width:50%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\"><span class=\"ico\">&#128197;</span> <span class=\"ico\">&#128336;</span> Actual In Time</div>\n                    <div class=\"fld-val\">{{ fmt_datetime(doc.actual_in_time) }}</div>\n                </div></td>\n                <td style=\"width:50%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\"><span class=\"ico\">&#128197;</span> <span class=\"ico\">&#128336;</span> Actual Out Time</div>\n                    <div class=\"fld-val\">{{ fmt_datetime(doc.actual_out_time) }}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td colspan=\"2\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Notes</div>\n                    <div class=\"fld-val notes-val\">{% if doc.notes %}{{ doc.notes|striptags }}{% endif %}</div>\n                </div></td>\n            </tr>\n        </table>\n    </div>\n\n    <div class=\"gp-footer\">\n        <div class=\"footer-note\">\n            <div class=\"footer-icon\">&#128100;</div>\n            <div>This gate pass is valid only for the purpose and duration mentioned above. Please follow all warehouse and safety regulations.</div>\n        </div>\n        <div class=\"sig-box\">\n            <div class=\"sig-row\">\n                <div class=\"sig-block\">\n                    <div class=\"sig-line\">{{ user_name(doc.authorized_by) }}</div>\n                    <div class=\"sig-lbl\">Authorized Signature</div>\n                </div>\n                <div class=\"sig-block\">\n                    <div class=\"sig-line\">{{ user_name(doc.security_checked_by) }}</div>\n                    <div class=\"sig-lbl\">Security Signature</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n</div>\n</body>\n</html>\n",
