{
 "align_labels_right": 0,
 "creation": "2026-06-30 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Warehouse Job",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 9,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        html, body {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 8pt;\n            line-height: 1.25;\n            color: #2d3748;\n            background: #fff;\n        }\n        .wj-page {\n            width: 100%;\n            max-width: 210mm;\n            margin: 0 auto;\n            border: 1.5px solid #8a939c;\n            padding: 3mm;\n        }\n        .wj-header {\n            display: grid;\n            grid-template-columns: 1fr auto 1fr;\n            align-items: start;\n            gap: 2mm;\n            margin-bottom: 2.5mm;\n            padding-bottom: 2mm;\n            border-bottom: 1px solid #c5ccd3;\n        }\n        .wj-brand { display: flex; gap: 2mm; align-items: flex-start; min-width: 0; }\n        .wj-logo { width: 14mm; height: 14mm; object-fit: contain; flex-shrink: 0; }\n        .wj-logo-ph {\n            width: 14mm; height: 14mm; border: 1px solid #b8c0c8; background: #e8eaed;\n            color: #6c757d; display: flex; align-items: center; justify-content: center;\n            font-size: 14pt; flex-shrink: 0;\n        }\n        .wj-company-name { font-size: 9pt; font-weight: bold; color: #4a5568; line-height: 1.15; }\n        .wj-company-tag { font-size: 6.5pt; color: #718096; margin-top: 0.3mm; }\n        .wj-title {\n            font-size: 16pt; font-weight: 900; letter-spacing: 0.06em;\n            color: #5a6268; text-align: center; align-self: center;\n        }\n        .wj-no-box {\n            justify-self: end; border: 1px solid #8a939c; min-width: 38mm; text-align: center;\n        }\n        .wj-no-lbl {\n            background: #e8eaed; border-bottom: 1px solid #8a939c;\n            font-size: 7pt; font-weight: bold; color: #5a6268; padding: 0.8mm 2mm;\n        }\n        .wj-no-val { font-size: 9pt; font-weight: bold; padding: 1.2mm 2mm; min-height: 6mm; }\n\n        .info-grid { width: 100%; border-collapse: collapse; margin-bottom: 2.5mm; }\n        .info-grid td { border: 1px solid #b8c0c8; vertical-align: top; padding: 0; }\n        .fld { padding: 1mm 1.5mm; min-height: 8mm; }\n        .fld-lbl { font-size: 6.5pt; font-weight: bold; color: #5a6268; margin-bottom: 0.5mm; }\n        .fld-val { font-size: 8pt; color: #1a202c; min-height: 3.5mm; word-break: break-word; }\n\n        .section { margin-bottom: 2.5mm; border: 1px solid #b8c0c8; page-break-inside: avoid; }\n        .sec-head {\n            background: #5a6268; color: #fff; font-size: 7.5pt; font-weight: bold;\n            text-transform: uppercase; letter-spacing: 0.04em; padding: 1.2mm 2mm;\n            display: flex; align-items: center; gap: 2mm;\n        }\n        .sec-num {\n            display: inline-flex; align-items: center; justify-content: center;\n            width: 4.5mm; height: 4.5mm; border: 1px solid rgba(255,255,255,0.85);\n            border-radius: 50%; font-size: 6.5pt; flex-shrink: 0;\n        }\n        .sec-grid { width: 100%; border-collapse: collapse; }\n        .sec-grid td { border: 1px solid #d5dbe0; vertical-align: top; padding: 0; }\n\n        .data-t {\n            width: 100%; border-collapse: collapse;\n        }\n        .data-t th {\n            background: #e8eaed; border: 1px solid #b8c0c8; padding: 1mm 1.2mm;\n            font-size: 6.5pt; font-weight: bold; color: #4a5568; text-align: center;\n        }\n        .data-t td {\n            border: 1px solid #d5dbe0; padding: 1mm 1.2mm; font-size: 7pt;\n            vertical-align: top; min-height: 5mm;\n        }\n        .data-t td.num, .data-t th.num { text-align: right; }\n        .data-t td.center { text-align: center; }\n        .data-t tr.total-row td { font-weight: bold; background: #f0f2f4; border-top: 1px solid #8a939c; }\n\n        .status-row { display: flex; flex-wrap: wrap; gap: 2mm 3mm; padding: 0.5mm 0; }\n        .status-opt { display: inline-flex; align-items: center; gap: 1mm; font-size: 7pt; }\n        .chk {\n            width: 3mm; height: 3mm; border: 1px solid #8a939c; display: inline-flex;\n            align-items: center; justify-content: center; font-size: 6pt; font-weight: bold;\n            background: #fff; flex-shrink: 0;\n        }\n        .chk.on { background: #5a6268; color: #fff; }\n\n        .notes-val { font-size: 7.5pt; min-height: 8mm; white-space: pre-wrap; word-break: break-word; }\n\n        .wj-footer {\n            display: grid; grid-template-columns: 1fr auto; gap: 3mm; align-items: end;\n            margin-top: 2mm; padding-top: 2mm; border-top: 1px solid #c5ccd3;\n        }\n        .sig-box { border: 1px dashed #8a939c; padding: 2mm 3mm; min-width: 72mm; }\n        .sig-row { display: grid; grid-template-columns: 1fr 1fr; gap: 4mm; }\n        .sig-block { text-align: center; }\n        .sig-line {\n            border-bottom: 1px solid #5a6268; min-height: 10mm; margin-bottom: 1mm;\n            display: flex; align-items: flex-end; justify-content: center;\n            font-size: 7pt; color: #4a5568; padding-bottom: 0.5mm;\n        }\n        .sig-lbl { font-size: 6.5pt; color: #5a6268; font-weight: bold; }\n        .footer-note { font-size: 6.5pt; color: #4a5568; line-height: 1.35; }\n\n        @page { size: A4; margin: 8mm 10mm; }\n        @media print {\n            html, body { margin: 0; padding: 0; }\n            .wj-page { border: 1.5px solid #8a939c; max-width: 100%; }\n            .sec-head, .chk.on { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n        }\n    </style>\n</head>\n<body>\n\n{% macro fmt_date(val) -%}\n{%- if val -%}{{ frappe.utils.formatdate(val, \"dd-MM-yyyy\") }}{%- endif -%}\n{%- endmacro %}\n\n{% macro fmt_datetime(val) -%}\n{%- if val -%}{{ frappe.utils.format_datetime(val) }}{%- endif -%}\n{%- endmacro %}\n\n{% macro fmt_num(val, precision=3) -%}\n{%- if val is not none and val != '' -%}{{ frappe.utils.fmt_money(val, precision=precision) }}{%- endif -%}\n{%- endmacro %}\n\n{% macro customer_name(cust) -%}\n{%- if cust -%}{{ frappe.db.get_value(\"Customer\", cust, \"customer_name\") or cust }}{%- endif -%}\n{%- endmacro %}\n\n{% macro party_name(doctype, name) -%}\n{%- if name and doctype and frappe.db.exists(doctype, name) -%}\n{{ frappe.db.get_value(doctype, name, \"shipper_name\" if doctype == \"Shipper\" else \"consignee_name\") or name }}\n{%- elif name -%}{{ name }}{%- endif -%}\n{%- endmacro %}\n\n{% set default_company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") or frappe.db.get_default(\"company\") %}\n{% set company_doc = None %}\n{% if doc.company and frappe.db.exists(\"Company\", doc.company) %}\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n{% elif default_company and frappe.db.exists(\"Company\", default_company) %}\n{% set company_doc = frappe.get_doc(\"Company\", default_company) %}\n{% endif %}\n\n{% set job_type = (doc.type or '')|trim %}\n{% set title_map = {\n    'Putaway': 'PUTAWAY JOB',\n    'Pick': 'PICK JOB',\n    'Move': 'MOVE JOB',\n    'Stocktake': 'STOCKTAKE JOB',\n    'VAS': 'VAS JOB'\n} %}\n{% set job_title = title_map.get(job_type, (job_type|upper + ' JOB') if job_type else 'WAREHOUSE JOB') %}\n{% set is_stocktake = job_type == 'Stocktake' %}\n{% set is_vas = job_type == 'VAS' %}\n{% set status_options = ['Draft', 'Submitted', 'In Progress', 'Completed', 'Closed', 'Reopened', 'Cancelled'] %}\n{% set item_rows = doc.items or [] %}\n{% set count_rows = doc.counts or [] %}\n{% set dock_rows = doc.docks or [] %}\n{% set op_rows = doc.operations or [] %}\n{% set min_rows = 4 %}\n{% set item_pad = min_rows - (item_rows|length) if (item_rows|length) < min_rows else 0 %}\n{% set count_pad = min_rows - (count_rows|length) if (count_rows|length) < min_rows else 0 %}\n\n<div class=\"wj-page\">\n\n    <div class=\"wj-header\">\n        <div class=\"wj-brand\">\n            {% if company_doc and company_doc.company_logo %}\n            <img src=\"{{ company_doc.company_logo }}\" alt=\"\" class=\"wj-logo\" />\n            {% elif company_doc and company_doc.logo %}\n            <img src=\"{{ company_doc.logo }}\" alt=\"\" class=\"wj-logo\" />\n            {% else %}\n            <div class=\"wj-logo-ph\">&#8962;</div>\n            {% endif %}\n            <div>\n                <div class=\"wj-company-name\">{{ (company_doc.company_name if company_doc else doc.company) or \"YOUR COMPANY\" }}</div>\n                <div class=\"wj-company-tag\">{{ doc.branch or '' }}</div>\n            </div>\n        </div>\n        <div class=\"wj-title\">{{ job_title }}</div>\n        <div class=\"wj-no-box\">\n            <div class=\"wj-no-lbl\">Job No.</div>\n            <div class=\"wj-no-val\">{{ doc.name }}</div>\n        </div>\n    </div>\n\n    <table class=\"info-grid\">\n        <tr>\n            <td style=\"width:25%\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Job Open Date</div>\n                <div class=\"fld-val\">{{ fmt_date(doc.job_open_date) }}</div>\n            </div></td>\n            <td style=\"width:25%\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Job Type</div>\n                <div class=\"fld-val\">{{ job_type }}</div>\n            </div></td>\n            <td style=\"width:25%\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Job Status</div>\n                <div class=\"fld-val\">{{ doc.job_status or '' }}</div>\n            </div></td>\n            <td style=\"width:25%\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Job Number</div>\n                <div class=\"fld-val\">{{ doc.job_number or '' }}</div>\n            </div></td>\n        </tr>\n        <tr>\n            <td colspan=\"2\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Customer</div>\n                <div class=\"fld-val\">{{ customer_name(doc.customer) }}</div>\n            </div></td>\n            <td><div class=\"fld\">\n                <div class=\"fld-lbl\">Shipper</div>\n                <div class=\"fld-val\">{{ party_name('Shipper', doc.shipper) }}</div>\n            </div></td>\n            <td><div class=\"fld\">\n                <div class=\"fld-lbl\">Consignee</div>\n                <div class=\"fld-val\">{{ party_name('Consignee', doc.consignee) }}</div>\n            </div></td>\n        </tr>\n        <tr>\n            <td colspan=\"2\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Reference Order</div>\n                <div class=\"fld-val\">{% if doc.reference_order_type %}{{ doc.reference_order_type }}: {% endif %}{{ doc.reference_order or '' }}</div>\n            </div></td>\n            <td colspan=\"2\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Warehouse Contract</div>\n                <div class=\"fld-val\">{{ doc.warehouse_contract or '' }}</div>\n            </div></td>\n        </tr>\n        <tr>\n            <td><div class=\"fld\">\n                <div class=\"fld-lbl\">Company</div>\n                <div class=\"fld-val\">{{ doc.company or '' }}</div>\n            </div></td>\n            <td><div class=\"fld\">\n                <div class=\"fld-lbl\">Branch</div>\n                <div class=\"fld-val\">{{ doc.branch or '' }}</div>\n            </div></td>\n            <td><div class=\"fld\">\n                <div class=\"fld-lbl\">Cost Center</div>\n                <div class=\"fld-val\">{{ doc.cost_center or '' }}</div>\n            </div></td>\n            <td><div class=\"fld\">\n                <div class=\"fld-lbl\">Profit Center</div>\n                <div class=\"fld-val\">{{ doc.profit_center or '' }}</div>\n            </div></td>\n        </tr>\n        {% if not is_stocktake %}\n        <tr>\n            <td colspan=\"2\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Staging Area</div>\n                <div class=\"fld-val\">{{ doc.staging_area or '' }}</div>\n            </div></td>\n            {% if is_vas %}\n            <td colspan=\"2\"><div class=\"fld\">\n                <div class=\"fld-lbl\">VAS Order Type</div>\n                <div class=\"fld-val\">{{ doc.vas_order_type or '' }}</div>\n            </div></td>\n            {% else %}\n            <td colspan=\"2\"><div class=\"fld\">\n                <div class=\"fld-lbl\">Doc Status</div>\n                <div class=\"fld-val\">{{ {0: 'Draft', 1: 'Submitted', 2: 'Cancelled'}.get(doc.docstatus, '') }}</div>\n            </div></td>\n            {% endif %}\n        </tr>\n        {% endif %}\n    </table>\n\n    {% if is_stocktake %}\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">1</span> Count Sheet Details</div>\n        <table class=\"sec-grid\">\n            <tr>\n                <td style=\"width:25%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Count Date</div>\n                    <div class=\"fld-val\">{{ fmt_datetime(doc.count_date) }}</div>\n                </div></td>\n                <td style=\"width:25%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Count Type</div>\n                    <div class=\"fld-val\">{{ doc.count_type or '' }}</div>\n                </div></td>\n                <td style=\"width:25%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Blind Count</div>\n                    <div class=\"fld-val\">{{ 'Yes' if doc.blind_count else 'No' }}</div>\n                </div></td>\n                <td style=\"width:25%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">QA Required</div>\n                    <div class=\"fld-val\">{{ 'Yes' if doc.qa_required else 'No' }}</div>\n                </div></td>\n            </tr>\n        </table>\n    </div>\n    {% endif %}\n\n    {% if not is_stocktake and dock_rows %}\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">{% if is_stocktake %}2{% else %}1{% endif %}</span> Docking</div>\n        <table class=\"data-t\">\n            <thead>\n                <tr>\n                    <th>Dock Door</th>\n                    <th>ETA</th>\n                    <th>Transport Company</th>\n                    <th>Vehicle Type</th>\n                    <th>Plate No.</th>\n                    <th>Container Type</th>\n                    <th>Container No.</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for dock in dock_rows %}\n                <tr>\n                    <td>{{ dock.dock_door or '' }}</td>\n                    <td>{{ fmt_datetime(dock.eta) }}</td>\n                    <td>{{ dock.transport_company or '' }}</td>\n                    <td>{{ dock.vehicle_type or '' }}</td>\n                    <td>{{ dock.plate_no or '' }}</td>\n                    <td>{{ dock.container_type or '' }}</td>\n                    <td>{{ dock.container_no or '' }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n    {% endif %}\n\n    {% if is_stocktake %}\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">2</span> Count Lines</div>\n        <table class=\"data-t\">\n            <thead>\n                <tr>\n                    <th style=\"width:4%\">#</th>\n                    <th>Location</th>\n                    <th>Handling Unit</th>\n                    <th>Item</th>\n                    <th>Serial No.</th>\n                    <th>Batch No.</th>\n                    {% if not doc.blind_count %}<th class=\"num\">System Count</th>{% endif %}\n                    <th class=\"num\">Actual Count</th>\n                    <th class=\"center\">Counted</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% if count_rows %}\n                {% for row in count_rows %}\n                <tr>\n                    <td class=\"center\">{{ loop.index }}</td>\n                    <td>{{ row.location or '' }}</td>\n                    <td>{{ row.handling_unit or '' }}</td>\n                    <td>{{ row.item or '' }}</td>\n                    <td>{{ row.serial_no or '' }}</td>\n                    <td>{{ row.batch_no or '' }}</td>\n                    {% if not doc.blind_count %}<td class=\"num\">{{ fmt_num(row.system_count) }}</td>{% endif %}\n                    <td class=\"num\">{{ fmt_num(row.actual_quantity) }}</td>\n                    <td class=\"center\">{% if row.counted %}&#10003;{% endif %}</td>\n                </tr>\n                {% endfor %}\n                {% else %}\n                <tr><td colspan=\"{% if doc.blind_count %}8{% else %}9{% endif %}\" style=\"text-align:center;color:#718096;padding:3mm;\">No count lines</td></tr>\n                {% endif %}\n                {% for i in range(count_pad) %}\n                <tr>\n                    <td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td>\n                    {% if not doc.blind_count %}<td>&nbsp;</td>{% endif %}\n                    <td>&nbsp;</td><td>&nbsp;</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n    {% else %}\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">{% if dock_rows %}2{% else %}1{% endif %}</span>\n            {% if job_type == 'Putaway' %}Putaway Lines\n            {% elif job_type == 'Pick' %}Pick Lines\n            {% elif job_type == 'Move' %}Move Lines\n            {% elif job_type == 'VAS' %}VAS Lines\n            {% else %}Allocation Lines{% endif %}\n        </div>\n        <table class=\"data-t\">\n            <thead>\n                <tr>\n                    <th style=\"width:3%\">#</th>\n                    <th>Location</th>\n                    <th>Handling Unit</th>\n                    <th>Item</th>\n                    <th class=\"num\">Qty</th>\n                    <th>UOM</th>\n                    <th>Serial No.</th>\n                    <th>Batch No.</th>\n                    {% if is_vas %}<th>VAS Action</th>{% endif %}\n                    {% if job_type in ['Putaway', 'Pick', 'Move'] %}<th>Staging Area</th>{% endif %}\n                    <th class=\"num\">Volume</th>\n                    <th class=\"num\">Weight</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% if item_rows %}\n                {% for row in item_rows %}\n                <tr>\n                    <td class=\"center\">{{ loop.index }}</td>\n                    <td>{{ row.location or '' }}</td>\n                    <td>{{ row.handling_unit or '' }}</td>\n                    <td>{{ row.item or '' }}</td>\n                    <td class=\"num\">{{ fmt_num(row.quantity) }}</td>\n                    <td>{{ row.uom or '' }}</td>\n                    <td>{{ row.serial_no or '' }}</td>\n                    <td>{{ row.batch_no or '' }}</td>\n                    {% if is_vas %}<td>{{ row.vas_action or '' }}</td>{% endif %}\n                    {% if job_type in ['Putaway', 'Pick', 'Move'] %}<td>{{ row.staging_area or '' }}</td>{% endif %}\n                    <td class=\"num\">{{ fmt_num(row.volume) }}{% if row.volume_uom %} {{ row.volume_uom }}{% endif %}</td>\n                    <td class=\"num\">{{ fmt_num(row.weight) }}{% if row.weight_uom %} {{ row.weight_uom }}{% endif %}</td>\n                </tr>\n                {% endfor %}\n                {% else %}\n                <tr>\n                    <td colspan=\"{% if is_vas and job_type in ['Putaway','Pick','Move'] %}12{% elif is_vas or job_type in ['Putaway','Pick','Move'] %}11{% else %}10{% endif %}\"\n                        style=\"text-align:center;color:#718096;padding:3mm;\">No allocation lines</td>\n                </tr>\n                {% endif %}\n                {% for i in range(item_pad) %}\n                <tr>\n                    <td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td>\n                    <td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td>\n                    {% if is_vas %}<td>&nbsp;</td>{% endif %}\n                    {% if job_type in ['Putaway', 'Pick', 'Move'] %}<td>&nbsp;</td>{% endif %}\n                    <td>&nbsp;</td><td>&nbsp;</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n    {% endif %}\n\n    {% if op_rows %}\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">{% if is_stocktake %}3{% elif dock_rows %}3{% else %}2{% endif %}</span> Operations</div>\n        <table class=\"data-t\">\n            <thead>\n                <tr>\n                    <th class=\"center\">Order</th>\n                    <th>Operation</th>\n                    <th>Description</th>\n                    <th>Handling Basis</th>\n                    <th class=\"num\">Qty</th>\n                    <th class=\"num\">Std Hours</th>\n                    <th class=\"num\">Actual Hours</th>\n                    <th>Employee</th>\n                    <th>Start</th>\n                    <th>End</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for op in op_rows %}\n                <tr>\n                    <td class=\"center\">{{ op.order or loop.index }}</td>\n                    <td>{{ op.operation or '' }}</td>\n                    <td>{{ op.description or '' }}</td>\n                    <td>{{ op.handling_basis or '' }}</td>\n                    <td class=\"num\">{{ fmt_num(op.quantity) }}</td>\n                    <td class=\"num\">{{ fmt_num(op.total_std_hours, 2) }}</td>\n                    <td class=\"num\">{{ fmt_num(op.actual_hours, 2) }}</td>\n                    <td>{{ op.employee or '' }}</td>\n                    <td>{{ fmt_datetime(op.start_date) }}</td>\n                    <td>{{ fmt_datetime(op.end_date) }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n    {% endif %}\n\n    <div class=\"section\">\n        <div class=\"sec-head\"><span class=\"sec-num\">&#8721;</span> Job Totals</div>\n        <table class=\"sec-grid\">\n            <tr>\n                <td style=\"width:25%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Total Volume</div>\n                    <div class=\"fld-val\">{{ fmt_num(doc.total_volume) }}</div>\n                </div></td>\n                <td style=\"width:25%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Total Weight</div>\n                    <div class=\"fld-val\">{{ fmt_num(doc.total_weight) }}</div>\n                </div></td>\n                <td style=\"width:25%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Total Handling Units</div>\n                    <div class=\"fld-val\">{{ doc.total_handling_units or '' }}</div>\n                </div></td>\n                <td style=\"width:25%\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Total TEU</div>\n                    <div class=\"fld-val\">{{ fmt_num(doc.total_teu) }}</div>\n                </div></td>\n            </tr>\n            <tr>\n                <td colspan=\"4\"><div class=\"fld\">\n                    <div class=\"fld-lbl\">Job Status</div>\n                    <div class=\"status-row\">\n                        {% for opt in status_options %}\n                        <span class=\"status-opt\">\n                            <span class=\"chk{% if doc.job_status == opt %} on{% endif %}\">{% if doc.job_status == opt %}&#10003;{% endif %}</span>\n                            {{ opt }}\n                        </span>\n                        {% endfor %}\n                    </div>\n                </div></td>\n            </tr>\n        </table>\n    </div>\n\n    {% if doc.notes %}\n    <div class=\"section\">\n        <div class=\"sec-head\">Notes</div>\n        <div class=\"fld\">\n            <div class=\"fld-val notes-val\">{{ doc.notes|striptags }}</div>\n        </div>\n    </div>\n    {% endif %}\n\n    <div class=\"wj-footer\">\n        <div class=\"footer-note\">\n            This {{ job_type or 'warehouse' }} job sheet is for internal warehouse operations.\n            Verify locations, quantities, and handling units before posting transactions.\n        </div>\n        <div class=\"sig-box\">\n            <div class=\"sig-row\">\n                <div class=\"sig-block\">\n                    <div class=\"sig-line\">&nbsp;</div>\n                    <div class=\"sig-lbl\">Prepared By</div>\n                </div>\n                <div class=\"sig-block\">\n                    <div class=\"sig-line\">&nbsp;</div>\n                    <div class=\"sig-lbl\">Verified By</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n</div>\n</body>\n</html>\n",
 "idx": 0,
 "line_breaks": 0,
 "modified": "2026-06-30 12:00:00.000000",
 "modified_by": "Administrator",
 "module": "Warehousing",
 "name": "Warehouse Job",
 "owner": "Administrator",
 "print_format_builder": 0,
 "print_format_type": "Jinja",
 "raw_printing": 0,
 "show_section_headings": 0,
 "standard": "No"
}