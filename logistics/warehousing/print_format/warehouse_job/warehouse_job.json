{
 "align_labels_right": 0,
 "creation": "2026-06-30 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Warehouse Job",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 9,
 "html": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body {\n            font-family: Arial, Helvetica, sans-serif;\n            font-size: 9pt;\n            line-height: 1.4;\n            color: #000;\n            background: white;\n        }\n        .receipt-container {\n            width: 100%;\n            max-width: 210mm;\n            margin: 0 auto;\n            padding: 0;\n            background: white;\n            position: relative;\n        }\n        .receipt-body { display: block; }\n        .top-section { display: block; }\n\n        .header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 3mm;\n        }\n        .logo-placeholder {\n            width: 60mm; height: 30mm; background: #e0e0e0; border: 1px solid #ccc;\n            display: flex; align-items: center; justify-content: center;\n            font-size: 7pt; color: #666;\n        }\n        .company-logo { width: 60mm; height: 30mm; object-fit: contain; }\n        .company-info { flex: 1; text-align: left; padding-left: 3mm; }\n        .company-name {\n            font-size: 16pt; font-weight: 900; margin-bottom: 0; text-transform: uppercase;\n        }\n        .company-address { font-size: 7pt; line-height: 1.3; margin-bottom: 0; }\n        .vat-reg { font-size: 8.5pt; }\n\n        .main-body {\n            display: flex;\n            flex-direction: column;\n            justify-content: flex-start;\n            margin-bottom: 0;\n            margin-top: 35mm;\n            position: relative;\n        }\n\n        .info-block {\n            border: 2px solid #000;\n            padding: 1mm 1.5mm;\n            font-size: 7.5pt;\n            page-break-inside: avoid;\n            margin-bottom: 1.5mm;\n        }\n        .info-block .info-title {\n            font-weight: 900; font-size: 8pt; margin-bottom: 1mm;\n            border-bottom: 1px solid #000; padding-bottom: 0.5mm; letter-spacing: 0.02em;\n        }\n        .info-block .info-content {\n            display: flex; justify-content: space-between; gap: 3mm;\n        }\n        .left-column { flex: 1; padding-right: 2mm; }\n        .right-column { flex: 1; padding-left: 2mm; }\n        .left-column .field-row { justify-content: flex-end; }\n        .left-column .field-label { width: 32mm; }\n        .right-column .field-label { width: 32mm; text-align: right; }\n        .field-row {\n            display: flex; margin-bottom: 0.2mm; align-items: flex-start; gap: 1.5mm;\n        }\n        .field-label {\n            font-weight: bold; min-width: 22mm; font-size: 7.5pt;\n            flex-shrink: 0; text-align: right;\n        }\n        .field-value {\n            flex: 1; font-size: 7.5pt; min-height: 3.5mm;\n            padding: 0.2mm 0.3mm; background: white;\n        }\n\n        .customer-info-section {\n            position: absolute; top: -35mm; left: 1.5mm; z-index: 10; max-width: 80mm;\n        }\n        .customer-label {\n            font-weight: bold; font-size: 8pt; margin-top: 5mm;\n            margin-bottom: 2mm; line-height: 1;\n        }\n        .customer-name-box {\n            font-size: 11pt; font-weight: 900; margin-bottom: 0.1mm;\n            margin-top: -1mm; line-height: 1; background: white;\n        }\n        .customer-address-box { font-size: 8pt; background: white; width: 100mm; }\n        .customer-detail-row { font-size: 8pt; margin-top: 0.5mm; line-height: 1.2; }\n        .customer-detail-label { font-weight: bold; }\n\n        .qr-section {\n            position: absolute; top: -35mm; right: 1.5mm;\n            text-align: right; z-index: 10; margin-bottom: 3mm;\n        }\n        .qr-code { width: 1in; height: 1in; border: none; }\n        .receipt-title-qr {\n            font-size: 14pt; font-weight: 900; margin-top: 0.11mm;\n            margin-bottom: -1mm; text-align: right; text-transform: uppercase;\n        }\n        .reference-number { font-size: 8pt; font-weight: normal; margin-top: 0.1mm; }\n\n        .section-title {\n            font-size: 8pt; font-weight: bold; margin: 2mm 0 1mm 0;\n            text-transform: uppercase;\n        }\n\n        .invoice-table {\n            width: 100%; border-collapse: collapse; margin-top: 0;\n            border: none; line-height: 1.2; table-layout: auto;\n        }\n        .invoice-table thead { display: table-header-group; }\n        .invoice-table tbody { display: table-row-group; }\n        .table-header { background: transparent; }\n        .table-header th {\n            padding: 0; text-align: left; font-size: 8pt; font-weight: bold;\n            border: none; line-height: 1.0;\n        }\n        .table-header tr:first-child th {\n            background: #e0e0e0; color: #000; text-transform: uppercase;\n            padding: 0.3mm 0.5mm; line-height: 1.0;\n            border-top: 2px solid #000; border-bottom: 2px solid #000;\n            border-left: none; border-right: none;\n        }\n        .table-header tr:first-child th:first-child {\n            border-left: 2px solid #000 !important;\n            border-right: none !important;\n        }\n        .table-header tr:first-child th:last-child {\n            border-right: 2px solid #000 !important;\n        }\n        .table-row td {\n            padding: 0.3mm 0.5mm; font-size: 7.5pt; background: white;\n            border: none; border-bottom: 1px solid #ddd;\n            text-align: left; vertical-align: top; line-height: 1.2;\n        }\n        .table-row td.num, .table-header th.num { text-align: right; }\n        .table-row td.center { text-align: center; }\n        .table-row.total-row td {\n            font-weight: bold; border-top: 2px solid #000;\n            border-bottom: 1px solid #000; background: #f5f5f5;\n        }\n\n        .notes-section {\n            margin-top: 2mm; font-size: 7.5pt; line-height: 1.35;\n            border: 1px solid #000; padding: 1.5mm; page-break-inside: avoid;\n        }\n        .notes-title { font-weight: 900; margin-bottom: 1mm; font-size: 8pt; }\n\n        .footer-section {\n            margin-top: 10mm; padding-top: 2mm; padding-bottom: 1mm;\n            border-top: 2px solid #000; font-size: 7pt; background: white;\n            page-break-inside: avoid;\n        }\n        .footer-section table { width: 100%; border-collapse: collapse; }\n        .footer-section td {\n            padding: 0.4mm 2mm 0.4mm 0; font-size: 7pt; vertical-align: top;\n        }\n        .footer-section .footer-label {\n            font-weight: bold; white-space: nowrap; width: 1%; padding-right: 1.5mm;\n        }\n\n        .sig-section {\n            display: flex; justify-content: flex-end; gap: 8mm;\n            margin-top: 4mm; page-break-inside: avoid;\n        }\n        .sig-block { text-align: center; min-width: 45mm; }\n        .sig-line {\n            border-bottom: 1px solid #000; min-height: 12mm; margin-bottom: 1mm;\n        }\n        .sig-lbl { font-size: 7pt; font-weight: bold; }\n\n        @page { size: A4; margin: 12mm 12mm 20mm 12mm; }\n        @media print {\n            body { margin: 0; padding: 0; }\n            .receipt-container { max-width: 100%; padding-bottom: 22mm; }\n            .footer-section {\n                position: fixed; bottom: 0; left: 0; right: 0;\n                width: 100%; margin: 0; padding: 2mm 12mm;\n                border-top: 2px solid #000; background: white;\n                box-sizing: border-box; z-index: 1000;\n            }\n        }\n    </style>\n</head>\n<body>\n\n{% macro fmt_date(val) -%}\n{%- if val -%}{{ frappe.utils.formatdate(val, \"MM-dd-yyyy\") }}{%- endif -%}\n{%- endmacro %}\n\n{% macro fmt_datetime(val) -%}\n{%- if val -%}{{ frappe.utils.format_datetime(val) }}{%- endif -%}\n{%- endmacro %}\n\n{% macro fmt_num(val, precision=3) -%}\n{%- if val is not none and val != '' -%}{{ frappe.utils.fmt_money(val, precision=precision) }}{%- endif -%}\n{%- endmacro %}\n\n{% macro party_name(doctype, name) -%}\n{%- if name and doctype and frappe.db.exists(doctype, name) -%}\n{{ frappe.db.get_value(doctype, name, \"shipper_name\" if doctype == \"Shipper\" else \"consignee_name\") or name }}\n{%- elif name -%}{{ name }}{%- endif -%}\n{%- endmacro %}\n\n{% set default_company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") or frappe.db.get_default(\"company\") %}\n{% set company_doc = None %}\n{% if doc.company and frappe.db.exists(\"Company\", doc.company) %}\n{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n{% elif default_company and frappe.db.exists(\"Company\", default_company) %}\n{% set company_doc = frappe.get_doc(\"Company\", default_company) %}\n{% endif %}\n\n{% set job_type = (doc.type or '')|trim %}\n{% set title_map = {\n    'Putaway': 'PUTAWAY JOB',\n    'Pick': 'PICK JOB',\n    'Move': 'MOVE JOB',\n    'Stocktake': 'STOCKTAKE JOB',\n    'VAS': 'VAS JOB'\n} %}\n{% set job_title = title_map.get(job_type, (job_type|upper + ' JOB') if job_type else 'WAREHOUSE JOB') %}\n{% set is_stocktake = job_type == 'Stocktake' %}\n{% set is_vas = job_type == 'VAS' %}\n{% set item_rows = doc.items or [] %}\n{% set count_rows = doc.counts or [] %}\n{% set dock_rows = doc.docks or [] %}\n{% set op_rows = doc.operations or [] %}\n\n<div class=\"receipt-container\">\n<div class=\"receipt-body\">\n<div class=\"top-section\">\n\n    <div class=\"header\">\n        {% if company_doc %}\n        {% if company_doc.company_logo %}\n            <img src=\"{{ company_doc.company_logo }}\" alt=\"Company Logo\" class=\"company-logo\" />\n        {% elif company_doc.logo %}\n            <img src=\"{{ company_doc.logo }}\" alt=\"Company Logo\" class=\"company-logo\" />\n        {% elif company_doc.image %}\n            <img src=\"{{ company_doc.image }}\" alt=\"Company Logo\" class=\"company-logo\" />\n        {% else %}\n            <div class=\"logo-placeholder\">company_logo</div>\n        {% endif %}\n        <div class=\"company-info\">\n            <div class=\"company-name\">{{ company_doc.company_name or doc.company }}</div>\n            <div class=\"company-address\">\n                {% if company_doc.address and frappe.db.exists(\"Address\", company_doc.address) %}\n                    {% set company_address = frappe.get_doc(\"Address\", company_doc.address) %}\n                    {{ company_address.address_line1 or '' }}\n                    {% if company_address.address_line2 %} {{ company_address.address_line2 }}{% endif %}\n                    {% if company_address.city %} {{ company_address.city }}{% endif %}\n                    {% if company_address.state %}, {{ company_address.state }}{% endif %}\n                    {% if company_address.country %} {{ company_address.country }}{% endif %}\n                    {% if company_address.pincode %} {{ company_address.pincode }}{% endif %}\n                {% elif company_doc.address_line1 %}\n                    {{ company_doc.address_line1 }}<br>\n                    {% if company_doc.address_line2 %}{{ company_doc.address_line2 }}<br>{% endif %}\n                    {{ company_doc.city }}{% if company_doc.state %}, {{ company_doc.state }}{% endif %}<br>\n                    {{ company_doc.country }}{% if company_doc.pincode %} {{ company_doc.pincode }}{% endif %}\n                {% endif %}\n            </div>\n            <div class=\"vat-reg\">\n                {% if doc.branch and frappe.db.exists(\"Branch\", doc.branch) %}\n                    {% set branch_doc = frappe.get_doc(\"Branch\", doc.branch) %}\n                    {% if branch_doc.custom_registration_details %}\n                        {{ branch_doc.custom_registration_details }}\n                    {% elif company_doc.tax_id %}\n                        VAT Reg. TIN: {{ company_doc.tax_id }}\n                    {% elif company_doc.tin %}\n                        VAT Reg. TIN: {{ company_doc.tin }}\n                    {% endif %}\n                {% elif company_doc.tax_id %}\n                    VAT Reg. TIN: {{ company_doc.tax_id }}\n                {% elif company_doc.tin %}\n                    VAT Reg. TIN: {{ company_doc.tin }}\n                {% endif %}\n            </div>\n        </div>\n        {% else %}\n            <div class=\"logo-placeholder\">company_logo</div>\n            <div class=\"company-info\">\n                <div class=\"company-name\">{{ doc.company or default_company or '' }}</div>\n            </div>\n        {% endif %}\n    </div>\n\n    <div class=\"main-body\">\n        <div class=\"customer-info-section\">\n            <div class=\"customer-label\">CUSTOMER</div>\n            <div class=\"customer-name-box\">\n                {% if doc.customer %}\n                    {% set cust = frappe.get_doc(\"Customer\", doc.customer) %}\n                    {{ cust.customer_name or doc.customer }}\n                {% endif %}\n            </div>\n            <div class=\"customer-address-box\">\n                {% if doc.customer %}\n                    {% set cust = frappe.get_doc(\"Customer\", doc.customer) %}\n                    {% if cust.customer_primary_address and frappe.db.exists(\"Address\", cust.customer_primary_address) %}\n                        {% set addr = frappe.get_doc(\"Address\", cust.customer_primary_address) %}\n                        {{ addr.address_line1 or '' }}\n                        {% if addr.address_line2 %} {{ addr.address_line2 }}{% endif %}\n                        {% if addr.city %} {{ addr.city }}{% endif %}\n                        {% if addr.state %}, {{ addr.state }}{% endif %}\n                        {% if addr.country %} {{ addr.country }}{% endif %}\n                        {% if addr.pincode %} {{ addr.pincode }}{% endif %}\n                    {% endif %}\n                {% endif %}\n            </div>\n            {% if doc.customer %}\n            <div class=\"customer-detail-row\">\n                <span class=\"customer-detail-label\">Shipper:</span>\n                {{ party_name('Shipper', doc.shipper) or '-' }}\n            </div>\n            <div class=\"customer-detail-row\">\n                <span class=\"customer-detail-label\">Consignee:</span>\n                {{ party_name('Consignee', doc.consignee) or '-' }}\n            </div>\n            {% endif %}\n        </div>\n\n        <div class=\"qr-section\">\n            {% set qr_url = 'https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + doc.name|urlencode %}\n            <img src=\"{{ qr_url }}\" alt=\"QR Code\" class=\"qr-code\" />\n            <div class=\"receipt-title-qr\">{{ job_title }}</div>\n            <div class=\"reference-number\">{{ doc.name }}</div>\n        </div>\n\n        <div class=\"info-block\">\n            <div class=\"info-title\">JOB INFORMATION</div>\n            <div class=\"info-content\">\n                <div class=\"left-column\">\n                    <div class=\"field-row\"><div class=\"field-label\">JOB NO.:</div><div class=\"field-value\">{{ doc.name }}</div></div>\n                    <div class=\"field-row\"><div class=\"field-label\">JOB TYPE:</div><div class=\"field-value\">{{ job_type }}</div></div>\n                    <div class=\"field-row\"><div class=\"field-label\">JOB STATUS:</div><div class=\"field-value\">{{ doc.job_status or '' }}</div></div>\n                    <div class=\"field-row\"><div class=\"field-label\">JOB NUMBER:</div><div class=\"field-value\">{{ doc.job_number or '' }}</div></div>\n                    <div class=\"field-row\"><div class=\"field-label\">OPEN DATE:</div><div class=\"field-value\">{{ fmt_date(doc.job_open_date) }}</div></div>\n                    {% if not is_stocktake %}\n                    <div class=\"field-row\"><div class=\"field-label\">STAGING AREA:</div><div class=\"field-value\">{{ doc.staging_area or '' }}</div></div>\n                    {% endif %}\n                </div>\n                <div class=\"right-column\">\n                    <div class=\"field-row\"><div class=\"field-label\">REFERENCE ORDER:</div><div class=\"field-value\">{% if doc.reference_order_type %}{{ doc.reference_order_type }}: {% endif %}{{ doc.reference_order or '' }}</div></div>\n                    <div class=\"field-row\"><div class=\"field-label\">CONTRACT:</div><div class=\"field-value\">{{ doc.warehouse_contract or '' }}</div></div>\n                    <div class=\"field-row\"><div class=\"field-label\">BRANCH:</div><div class=\"field-value\">{{ doc.branch or '' }}</div></div>\n                    <div class=\"field-row\"><div class=\"field-label\">DOC STATUS:</div><div class=\"field-value\">{{ {0: 'Draft', 1: 'Submitted', 2: 'Cancelled'}.get(doc.docstatus, '') }}</div></div>\n                    {% if is_vas %}\n                    <div class=\"field-row\"><div class=\"field-label\">VAS ORDER TYPE:</div><div class=\"field-value\">{{ doc.vas_order_type or '' }}</div></div>\n                    {% endif %}\n                    {% if is_stocktake %}\n                    <div class=\"field-row\"><div class=\"field-label\">COUNT TYPE:</div><div class=\"field-value\">{{ doc.count_type or '' }}</div></div>\n                    <div class=\"field-row\"><div class=\"field-label\">COUNT DATE:</div><div class=\"field-value\">{{ fmt_datetime(doc.count_date) }}</div></div>\n                    {% endif %}\n                </div>\n            </div>\n        </div>\n    </div>\n\n    {% if is_stocktake %}\n    <div class=\"info-block\">\n        <div class=\"info-title\">COUNT SHEET DETAILS</div>\n        <div class=\"info-content\">\n            <div class=\"left-column\">\n                <div class=\"field-row\"><div class=\"field-label\">BLIND COUNT:</div><div class=\"field-value\">{{ 'Yes' if doc.blind_count else 'No' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">QA REQUIRED:</div><div class=\"field-value\">{{ 'Yes' if doc.qa_required else 'No' }}</div></div>\n            </div>\n            <div class=\"right-column\">\n                <div class=\"field-row\"><div class=\"field-label\">DAYS PAST ZERO:</div><div class=\"field-value\">{{ doc.stocktake_days_past_zero or '' }}</div></div>\n            </div>\n        </div>\n    </div>\n    {% endif %}\n\n    {% if not is_stocktake and dock_rows %}\n    <div class=\"section-title\">Docking</div>\n    <table class=\"invoice-table\">\n        <thead class=\"table-header\">\n            <tr>\n                <th>Dock Door</th>\n                <th>ETA</th>\n                <th>Transport Company</th>\n                <th>Vehicle Type</th>\n                <th>Plate No.</th>\n                <th>Container Type</th>\n                <th>Container No.</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for dock in dock_rows %}\n            <tr class=\"table-row\">\n                <td>{{ dock.dock_door or '' }}</td>\n                <td>{{ fmt_datetime(dock.eta) }}</td>\n                <td>{{ dock.transport_company or '' }}</td>\n                <td>{{ dock.vehicle_type or '' }}</td>\n                <td>{{ dock.plate_no or '' }}</td>\n                <td>{{ dock.container_type or '' }}</td>\n                <td>{{ dock.container_no or '' }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    {% endif %}\n\n    {% if is_stocktake %}\n    <div class=\"section-title\">Count Lines</div>\n    <table class=\"invoice-table\">\n        <thead class=\"table-header\">\n            <tr>\n                <th class=\"center\">#</th>\n                <th>Location</th>\n                <th>Handling Unit</th>\n                <th>Item</th>\n                <th>Serial No.</th>\n                <th>Batch No.</th>\n                {% if not doc.blind_count %}<th class=\"num\">System Count</th>{% endif %}\n                <th class=\"num\">Actual Count</th>\n                <th class=\"center\">Counted</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% if count_rows %}\n            {% for row in count_rows %}\n            <tr class=\"table-row\">\n                <td class=\"center\">{{ loop.index }}</td>\n                <td>{{ row.location or '' }}</td>\n                <td>{{ row.handling_unit or '' }}</td>\n                <td>{{ row.item or '' }}</td>\n                <td>{{ row.serial_no or '' }}</td>\n                <td>{{ row.batch_no or '' }}</td>\n                {% if not doc.blind_count %}<td class=\"num\">{{ fmt_num(row.system_count) }}</td>{% endif %}\n                <td class=\"num\">{{ fmt_num(row.actual_quantity) }}</td>\n                <td class=\"center\">{% if row.counted %}&#10003;{% endif %}</td>\n            </tr>\n            {% endfor %}\n            {% else %}\n            <tr class=\"table-row\"><td colspan=\"{% if doc.blind_count %}8{% else %}9{% endif %}\" style=\"text-align:center;padding:3mm;\">No count lines</td></tr>\n            {% endif %}\n        </tbody>\n    </table>\n    {% else %}\n    <div class=\"section-title\">\n        {% if job_type == 'Putaway' %}Putaway Lines\n        {% elif job_type == 'Pick' %}Pick Lines\n        {% elif job_type == 'Move' %}Move Lines\n        {% elif job_type == 'VAS' %}VAS Lines\n        {% else %}Allocation Lines{% endif %}\n    </div>\n    <table class=\"invoice-table\">\n        <thead class=\"table-header\">\n            <tr>\n                <th class=\"center\">#</th>\n                <th>Location</th>\n                <th>Handling Unit</th>\n                <th>Item</th>\n                <th class=\"num\">Qty</th>\n                <th>UOM</th>\n                <th>Serial No.</th>\n                <th>Batch No.</th>\n                {% if is_vas %}<th>VAS Action</th>{% endif %}\n                {% if job_type in ['Putaway', 'Pick', 'Move'] %}<th>Staging Area</th>{% endif %}\n                <th class=\"num\">Volume</th>\n                <th class=\"num\">Weight</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% if item_rows %}\n            {% for row in item_rows %}\n            <tr class=\"table-row\">\n                <td class=\"center\">{{ loop.index }}</td>\n                <td>{{ row.location or '' }}</td>\n                <td>{{ row.handling_unit or '' }}</td>\n                <td>{{ row.item or '' }}</td>\n                <td class=\"num\">{{ fmt_num(row.quantity) }}</td>\n                <td>{{ row.uom or '' }}</td>\n                <td>{{ row.serial_no or '' }}</td>\n                <td>{{ row.batch_no or '' }}</td>\n                {% if is_vas %}<td>{{ row.vas_action or '' }}</td>{% endif %}\n                {% if job_type in ['Putaway', 'Pick', 'Move'] %}<td>{{ row.staging_area or '' }}</td>{% endif %}\n                <td class=\"num\">{{ fmt_num(row.volume) }}{% if row.volume_uom %} {{ row.volume_uom }}{% endif %}</td>\n                <td class=\"num\">{{ fmt_num(row.weight) }}{% if row.weight_uom %} {{ row.weight_uom }}{% endif %}</td>\n            </tr>\n            {% endfor %}\n            {% else %}\n            <tr class=\"table-row\">\n                <td colspan=\"{% if is_vas and job_type in ['Putaway','Pick','Move'] %}12{% elif is_vas or job_type in ['Putaway','Pick','Move'] %}11{% else %}10{% endif %}\"\n                    style=\"text-align:center;padding:3mm;\">No allocation lines</td>\n            </tr>\n            {% endif %}\n        </tbody>\n    </table>\n    {% endif %}\n\n    {% if op_rows %}\n    <div class=\"section-title\">Operations</div>\n    <table class=\"invoice-table\">\n        <thead class=\"table-header\">\n            <tr>\n                <th class=\"center\">Order</th>\n                <th>Operation</th>\n                <th>Description</th>\n                <th>Handling Basis</th>\n                <th class=\"num\">Qty</th>\n                <th class=\"num\">Std Hours</th>\n                <th class=\"num\">Actual Hours</th>\n                <th>Employee</th>\n                <th>Start</th>\n                <th>End</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for op in op_rows %}\n            <tr class=\"table-row\">\n                <td class=\"center\">{{ op.order or loop.index }}</td>\n                <td>{{ op.operation or '' }}</td>\n                <td>{{ op.description or '' }}</td>\n                <td>{{ op.handling_basis or '' }}</td>\n                <td class=\"num\">{{ fmt_num(op.quantity) }}</td>\n                <td class=\"num\">{{ fmt_num(op.total_std_hours, 2) }}</td>\n                <td class=\"num\">{{ fmt_num(op.actual_hours, 2) }}</td>\n                <td>{{ op.employee or '' }}</td>\n                <td>{{ fmt_datetime(op.start_date) }}</td>\n                <td>{{ fmt_datetime(op.end_date) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    {% endif %}\n\n    <div class=\"info-block\">\n        <div class=\"info-title\">JOB TOTALS</div>\n        <div class=\"info-content\">\n            <div class=\"left-column\">\n                <div class=\"field-row\"><div class=\"field-label\">TOTAL VOLUME:</div><div class=\"field-value\">{{ fmt_num(doc.total_volume) }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">TOTAL WEIGHT:</div><div class=\"field-value\">{{ fmt_num(doc.total_weight) }}</div></div>\n            </div>\n            <div class=\"right-column\">\n                <div class=\"field-row\"><div class=\"field-label\">TOTAL HU:</div><div class=\"field-value\">{{ doc.total_handling_units or '' }}</div></div>\n                <div class=\"field-row\"><div class=\"field-label\">TOTAL TEU:</div><div class=\"field-value\">{{ fmt_num(doc.total_teu) }}</div></div>\n            </div>\n        </div>\n    </div>\n\n    {% if doc.notes %}\n    <div class=\"notes-section\">\n        <div class=\"notes-title\">NOTES</div>\n        {{ doc.notes|striptags }}\n    </div>\n    {% endif %}\n\n    <div class=\"sig-section\">\n        <div class=\"sig-block\">\n            <div class=\"sig-line\"></div>\n            <div class=\"sig-lbl\">Prepared By</div>\n        </div>\n        <div class=\"sig-block\">\n            <div class=\"sig-line\"></div>\n            <div class=\"sig-lbl\">Verified By</div>\n        </div>\n    </div>\n\n    <div class=\"footer-section\">\n        <table>\n            <tr>\n                <td class=\"footer-label\">Company:</td>\n                <td>{{ doc.company or '' }}</td>\n                <td class=\"footer-label\">Branch:</td>\n                <td>{{ doc.branch or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"footer-label\">Cost Center:</td>\n                <td>{{ doc.cost_center or '' }}</td>\n                <td class=\"footer-label\">Profit Center:</td>\n                <td>{{ doc.profit_center or '' }}</td>\n            </tr>\n            <tr>\n                <td class=\"footer-label\">Job Number:</td>\n                <td>{{ doc.job_number or '' }}</td>\n                <td class=\"footer-label\">Job Type:</td>\n                <td>{{ job_type }}</td>\n            </tr>\n        </table>\n    </div>\n\n</div>\n</div>\n</div>\n\n</body>\n</html>\n",
